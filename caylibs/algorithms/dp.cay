/**
 * algo::dp - 动态规划算法库
 *
 * 提供经典动态规划算法的工业级实现：
 * - 斐波那契数列 (迭代优化)
 * - 0/1 背包问题
 * - 最长公共子序列 (LCS)
 * - 最长递增子序列 (LIS)
 * - 硬币找零 (最小硬币数)
 * - 编辑距离 (Levenshtein)
 * - 最大子数组和 (Kadane)
 * - 爬楼梯问题
 * - 打家劫舍问题
 *
 * 版本: 0.5.3.1
 * 时间复杂度: 标注于各方法
 * 磁盘I/O: 无（纯计算）
 */

#pragma once

namespace algo {
    namespace dp {

        /* ========================================================================
         * DP 工具类 - 静态方法集合
         * ======================================================================== */

        public class DP {

            // ==================== 斐波那契数列 ====================

            /**
             * 计算第 n 个斐波那契数
             * 使用迭代法，避免递归栈溢出
             *
             * @param n 非负整数索引
             * @return 第 n 个斐波那契数
             * 时间复杂度: O(n)
             * 空间复杂度: O(1)
             */
            public static long fibonacci(int n) {
                if (n < 0) {
                    return 0L;
                }
                if (n <= 1) {
                    return (long)n;
                }

                long prev2 = 0L;
                long prev1 = 1L;
                long current = 0L;

                for (int i = 2; i <= n; i++) {
                    current = prev1 + prev2;
                    prev2 = prev1;
                    prev1 = current;
                }

                return current;
            }

            // ==================== 爬楼梯 ====================

            /**
             * 爬楼梯问题：n 阶楼梯，每次可爬 1 或 2 阶，求方案数
             *
             * @param n 楼梯阶数
             * @return 总方案数
             * 时间复杂度: O(n)
             * 空间复杂度: O(1)
             */
            public static long climbStairs(int n) {
                if (n < 0) {
                    return 0L;
                }
                if (n <= 2) {
                    return (long)n;
                }

                long prev2 = 1L;
                long prev1 = 2L;
                long current = 0L;

                for (int i = 3; i <= n; i++) {
                    current = prev1 + prev2;
                    prev2 = prev1;
                    prev1 = current;
                }

                return current;
            }

            // ==================== 最大子数组和 (Kadane) ====================

            /**
             * Kadane 算法：求连续子数组的最大和
             *
             * @param arr 输入数组
             * @param n 数组长度
             * @return 最大子数组和
             * 时间复杂度: O(n)
             * 空间复杂度: O(1)
             */
            public static int maxSubarraySum(int[] arr, int n) {
                if (arr == null || n <= 0) {
                    return 0;
                }

                int maxSoFar = arr[0];
                int maxEndingHere = arr[0];

                for (int i = 1; i < n; i++) {
                    if (maxEndingHere + arr[i] > arr[i]) {
                        maxEndingHere = maxEndingHere + arr[i];
                    } else {
                        maxEndingHere = arr[i];
                    }

                    if (maxEndingHere > maxSoFar) {
                        maxSoFar = maxEndingHere;
                    }
                }

                return maxSoFar;
            }

            // ==================== 打家劫舍 ====================

            /**
             * 打家劫舍问题：不能抢劫相邻房屋，求最大金额
             *
             * @param nums 各房屋金额数组
             * @param n 数组长度
             * @return 可抢劫的最大金额
             * 时间复杂度: O(n)
             * 空间复杂度: O(1)
             */
            public static int houseRobber(int[] nums, int n) {
                if (nums == null || n <= 0) {
                    return 0;
                }
                if (n == 1) {
                    return nums[0];
                }

                int prev2 = nums[0];
                int prev1 = nums[0];
                if (nums[1] > nums[0]) {
                    prev1 = nums[1];
                }

                for (int i = 2; i < n; i++) {
                    int current = prev1;
                    if (prev2 + nums[i] > prev1) {
                        current = prev2 + nums[i];
                    }
                    prev2 = prev1;
                    prev1 = current;
                }

                return prev1;
            }

            // ==================== 最长公共子序列 (LCS) ====================

            /**
             * 计算两个字符串的最长公共子序列长度
             *
             * @param a 字符串 a
             * @param b 字符串 b
             * @return LCS 长度
             * 时间复杂度: O(m * n)
             * 空间复杂度: O(m * n)
             */
            public static int lcs(String a, String b) {
                if (a == null || b == null) {
                    return 0;
                }

                int m = a.length();
                int n = b.length();

                if (m == 0 || n == 0) {
                    return 0;
                }

                int[][] dp = new int[m + 1][n + 1]();

                for (int i = 1; i <= m; i++) {
                    for (int j = 1; j <= n; j++) {
                        if (a.charAt(i - 1) == b.charAt(j - 1)) {
                            dp[i][j] = dp[i - 1][j - 1] + 1;
                        } else {
                            if (dp[i - 1][j] > dp[i][j - 1]) {
                                dp[i][j] = dp[i - 1][j];
                            } else {
                                dp[i][j] = dp[i][j - 1];
                            }
                        }
                    }
                }

                return dp[m][n];
            }

            // ==================== 编辑距离 (Levenshtein) ====================

            /**
             * 计算两个字符串的编辑距离（Levenshtein 距离）
             * 操作：插入、删除、替换
             *
             * @param a 字符串 a
             * @param b 字符串 b
             * @return 最小编辑次数
             * 时间复杂度: O(m * n)
             * 空间复杂度: O(m * n)
             */
            public static int editDistance(String a, String b) {
                if (a == null) {
                    a = "";
                }
                if (b == null) {
                    b = "";
                }

                int m = a.length();
                int n = b.length();

                int[][] dp = new int[m + 1][n + 1]();

                for (int i = 0; i <= m; i++) {
                    dp[i][0] = i;
                }
                for (int j = 0; j <= n; j++) {
                    dp[0][j] = j;
                }

                for (int i = 1; i <= m; i++) {
                    for (int j = 1; j <= n; j++) {
                        if (a.charAt(i - 1) == b.charAt(j - 1)) {
                            dp[i][j] = dp[i - 1][j - 1];
                        } else {
                            int insertCost = dp[i][j - 1] + 1;
                            int deleteCost = dp[i - 1][j] + 1;
                            int replaceCost = dp[i - 1][j - 1] + 1;

                            int minCost = insertCost;
                            if (deleteCost < minCost) {
                                minCost = deleteCost;
                            }
                            if (replaceCost < minCost) {
                                minCost = replaceCost;
                            }

                            dp[i][j] = minCost;
                        }
                    }
                }

                return dp[m][n];
            }

            // ==================== 最长递增子序列 (LIS) ====================

            /**
             * 计算数组的最长严格递增子序列长度
             *
             * @param arr 输入数组
             * @param n 数组长度
             * @return LIS 长度
             * 时间复杂度: O(n^2)
             * 空间复杂度: O(n)
             */
            public static int lis(int[] arr, int n) {
                if (arr == null || n <= 0) {
                    return 0;
                }

                int[] dp = new int[n];
                for (int i = 0; i < n; i++) {
                    dp[i] = 1;
                }

                int maxLen = 1;

                for (int i = 1; i < n; i++) {
                    for (int j = 0; j < i; j++) {
                        if (arr[j] < arr[i] && dp[j] + 1 > dp[i]) {
                            dp[i] = dp[j] + 1;
                        }
                    }
                    if (dp[i] > maxLen) {
                        maxLen = dp[i];
                    }
                }

                return maxLen;
            }

            // ==================== 0/1 背包问题 ====================

            /**
             * 0/1 背包问题：在容量限制下求最大价值
             *
             * @param weights 物品重量数组
             * @param values 物品价值数组
             * @param n 物品数量
             * @param capacity 背包容量
             * @return 可获得的最大价值
             * 时间复杂度: O(n * capacity)
             * 空间复杂度: O(capacity)
             */
            public static int knapsack01(int[] weights, int[] values, int n, int capacity) {
                if (weights == null || values == null || n <= 0 || capacity <= 0) {
                    return 0;
                }

                int[] dp = new int[capacity + 1]();

                for (int i = 0; i < n; i++) {
                    if (weights[i] < 0) {
                        continue;
                    }
                    for (int w = capacity; w >= weights[i]; w--) {
                        int newVal = dp[w - weights[i]] + values[i];
                        if (newVal > dp[w]) {
                            dp[w] = newVal;
                        }
                    }
                }

                int maxValue = 0;
                for (int w = 0; w <= capacity; w++) {
                    if (dp[w] > maxValue) {
                        maxValue = dp[w];
                    }
                }

                return maxValue;
            }

            // ==================== 硬币找零 (最小硬币数) ====================

            /**
             * 硬币找零：求凑成金额所需的最少硬币数
             *
             * @param coins 硬币面额数组
             * @param n 硬币种类数
             * @param amount 目标金额
             * @return 最少硬币数，无法凑成返回 -1
             * 时间复杂度: O(n * amount)
             * 空间复杂度: O(amount)
             */
            public static int coinChange(int[] coins, int n, int amount) {
                if (coins == null || n <= 0 || amount < 0) {
                    return -1;
                }
                if (amount == 0) {
                    return 0;
                }

                int[] dp = new int[amount + 1];
                for (int i = 0; i <= amount; i++) {
                    dp[i] = amount + 1;
                }
                dp[0] = 0;

                for (int i = 0; i < n; i++) {
                    if (coins[i] <= 0) {
                        continue;
                    }
                    for (int j = coins[i]; j <= amount; j++) {
                        if (dp[j - coins[i]] + 1 < dp[j]) {
                            dp[j] = dp[j - coins[i]] + 1;
                        }
                    }
                }

                if (dp[amount] > amount) {
                    return -1;
                }

                return dp[amount];
            }

            // ==================== 最大正方形 ====================

            /**
             * 最大正方形：在二进制矩阵中寻找全为 1 的最大正方形边长
             *
             * @param matrix 二进制矩阵 (0 或 1)
             * @param rows 行数
             * @param cols 列数
             * @return 最大正方形边长
             * 时间复杂度: O(rows * cols)
             * 空间复杂度: O(cols)
             */
            public static int maximalSquare(int[][] matrix, int rows, int cols) {
                if (matrix == null || rows <= 0 || cols <= 0) {
                    return 0;
                }

                int[] prev = new int[cols + 1]();
                int[] curr = new int[cols + 1]();
                int maxSide = 0;

                for (int i = 1; i <= rows; i++) {
                    for (int j = 1; j <= cols; j++) {
                        if (matrix[i - 1][j - 1] == 1) {
                            int minVal = prev[j - 1];
                            if (curr[j - 1] < minVal) {
                                minVal = curr[j - 1];
                            }
                            if (prev[j] < minVal) {
                                minVal = prev[j];
                            }
                            curr[j] = minVal + 1;

                            if (curr[j] > maxSide) {
                                maxSide = curr[j];
                            }
                        } else {
                            curr[j] = 0;
                        }
                    }

                    int[] temp = prev;
                    prev = curr;
                    curr = temp;
                    for (int j = 0; j <= cols; j++) {
                        curr[j] = 0;
                    }
                }

                return maxSide;
            }

            // ==================== 最小路径和 ====================

            /**
             * 最小路径和：从左上角到右下角的最小路径和
             * 只能向右或向下移动
             *
             * @param grid 非负整数矩阵
             * @param rows 行数
             * @param cols 列数
             * @return 最小路径和
             * 时间复杂度: O(rows * cols)
             * 空间复杂度: O(cols)
             */
            public static int minPathSum(int[][] grid, int rows, int cols) {
                if (grid == null || rows <= 0 || cols <= 0) {
                    return 0;
                }

                int[] dp = new int[cols];
                dp[0] = grid[0][0];

                for (int j = 1; j < cols; j++) {
                    dp[j] = dp[j - 1] + grid[0][j];
                }

                for (int i = 1; i < rows; i++) {
                    dp[0] = dp[0] + grid[i][0];
                    for (int j = 1; j < cols; j++) {
                        if (dp[j] < dp[j - 1]) {
                            dp[j] = dp[j] + grid[i][j];
                        } else {
                            dp[j] = dp[j - 1] + grid[i][j];
                        }
                    }
                }

                return dp[cols - 1];
            }

            // ==================== 分割等和子集 ====================

            /**
             * 判断数组是否能分割成两个和相等的子集
             *
             * @param nums 非负整数数组
             * @param n 数组长度
             * @return 是否能分割
             * 时间复杂度: O(n * sum)
             * 空间复杂度: O(sum)
             */
            public static boolean canPartition(int[] nums, int n) {
                if (nums == null || n <= 0) {
                    return false;
                }

                int total = 0;
                for (int i = 0; i < n; i++) {
                    if (nums[i] < 0) {
                        return false;
                    }
                    total = total + nums[i];
                }

                if (total % 2 != 0) {
                    return false;
                }

                int target = total / 2;
                boolean[] dp = new boolean[target + 1]();
                dp[0] = true;

                for (int i = 0; i < n; i++) {
                    for (int j = target; j >= nums[i]; j--) {
                        if (dp[j - nums[i]]) {
                            dp[j] = true;
                        }
                    }
                }

                return dp[target];
            }

            // ==================== 不同路径 (网格路径数) ====================

            /**
             * 不同路径：从左上角到右下角的路径数
             * 只能向右或向下移动
             *
             * @param m 行数
             * @param n 列数
             * @return 路径总数
             * 时间复杂度: O(m * n)
             * 空间复杂度: O(n)
             */
            public static long uniquePaths(int m, int n) {
                if (m <= 0 || n <= 0) {
                    return 0L;
                }
                if (m == 1 || n == 1) {
                    return 1L;
                }

                int cols = n;
                if (m > n) {
                    cols = m;
                }

                long[] dp = new long[cols];
                for (int j = 0; j < cols; j++) {
                    dp[j] = 1L;
                }

                int rows = m;
                if (m > n) {
                    rows = n;
                }
                int inner = n;
                if (m > n) {
                    inner = m;
                }

                for (int i = 1; i < rows; i++) {
                    for (int j = 1; j < inner; j++) {
                        dp[j] = dp[j] + dp[j - 1];
                    }
                }

                return dp[inner - 1];
            }

            // ==================== 单词拆分 ====================

            /**
             * 单词拆分：判断字符串是否能被字典中的单词拼接而成
             *
             * @param s 目标字符串
             * @param wordDict 单词字典数组
             * @param dictSize 字典大小
             * @return 是否能拆分
             * 时间复杂度: O(s.length * dictSize * avgWordLen)
             * 空间复杂度: O(s.length)
             */
            public static boolean wordBreak(String s, String[] wordDict, int dictSize) {
                if (s == null || s.length() == 0) {
                    return true;
                }
                if (wordDict == null || dictSize <= 0) {
                    return false;
                }

                int len = s.length();
                boolean[] dp = new boolean[len + 1]();
                dp[0] = true;

                for (int i = 1; i <= len; i++) {
                    for (int j = 0; j < dictSize; j++) {
                        String word = wordDict[j];
                        int wlen = word.length();
                        if (wlen <= i) {
                            boolean match = true;
                            for (int k = 0; k < wlen; k++) {
                                if (s.charAt(i - wlen + k) != word.charAt(k)) {
                                    match = false;
                                    break;
                                }
                            }
                            if (match && dp[i - wlen]) {
                                dp[i] = true;
                                break;
                            }
                        }
                    }
                }

                return dp[len];
            }

        }

    }
}
