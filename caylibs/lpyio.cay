namespace std {
    public class LpyIO {
        @FreeFunction
        public static void print(String... msg, String end) {
            for (int i = 0; i < msg.length; i++) {
                print(msg[i]);
                if (i < msg.length - 1) {
                    print(" ");
                }
            }
            print(end);
        }
    }
}
