/**
 * Optional<T> - 零开销可选值容器 (tagged union 模式)
 * 
 * 取代 null，显式空值处理。编译期通过单态化 (monomorphization)
 * 为每个具体类型生成特化代码，无堆分配，无 RTTI。
 * 
 * 设计基于 ROADMAP 0.5.1.x (详见 ROADMAP.md)
 * 版本: 0.5.1.x
 * 
 * 用法示例:
 *   Optional<int> maybeInt = Optional<int>.of(42);
 *   if (maybeInt.isPresent()) {
 *       int val = maybeInt.get();
 *   }
 *   int result = maybeInt.orElse(0);
 */

#ifndef CAY_OPTIONAL_H
#define CAY_OPTIONAL_H

#include <Try.cay>

namespace std {

/**
 * Optional<T> - 泛型可选值容器
 *
 * 实现 `std::Try<T, Object>`：`?` 运算符经接口分派。
 * 空值即失败状态，错误类型为 Object（恒为 null）。
 *
 * 时间复杂度: O(1) 所有操作
 * 空间复杂度: O(1) 固定额外空间 (boolean + T)
 *
 * 注意: 当前为泛型类声明，类型参数 T 在编译期通过单态化特化
 */
public class Optional<T> implements Try<T, Object> {
    private boolean hasValue;
    private T value;

    /**
     * 创建一个包含值的 Optional
     * 时间复杂度: O(1)
     * 空间复杂度: O(1)
     */
    public static Optional<T> of(T value) {
        Optional<T> opt = new Optional<T>();
        opt.hasValue = true;
        opt.value = value;
        return opt;
    }

    /**
     * 创建一个空的 Optional
     * 时间复杂度: O(1)
     * 空间复杂度: O(1)
     */
    public static Optional<T> empty() {
        Optional<T> opt = new Optional<T>();
        opt.hasValue = false;
        return opt;
    }

    /**
     * 检查是否包含值
     * 时间复杂度: O(1)
     */
    public boolean isPresent() {
        return hasValue;
    }

    /**
     * 检查是否为空
     * 时间复杂度: O(1)
     */
    public boolean isEmpty() {
        return !hasValue;
    }

    /**
     * 获取值（不安全 - 需先检查 isPresent()）
     * 如果为空，行为未定义（release 模式跳过检查）
     * 时间复杂度: O(1)
     */
    public T get() {
        return value;
    }

    /**
     * 安全取值：为空时返回默认值
     * 时间复杂度: O(1)
     */
    public T orElse(T defaultValue) {
        if (hasValue) {
            return value;
        } else {
            return defaultValue;
        }
    }

    // ---- std::Try<T, Object> 接口实现 ----

    /**
     * Try::isOk — 成功状态查询（Optional 语义：有值即成功）。
     * 时间复杂度: O(1)
     */
    public bool isOk() {
        return this.hasValue;
    }

    /**
     * Try::getValue — 提取成功值（不检查状态；? 运算符在 isOk()==true 分支调用）。
     * 时间复杂度: O(1)
     */
    public T getValue() {
        return this.value;
    }

    /**
     * Try::getError — 提取失败错误。
     * Optional 无显式错误，空值时返回 null（Object）。
     * 时间复杂度: O(1)
     */
    public Object getError() {
        return null;
    }

    /**
     * Try::fromError — 工厂方法：从错误构造失败实例。
     * Optional 忽略 error 参数，直接返回 empty（无错误载体）。
     * 实现约定：不访问 this（? 编译器以 null 调用，经返回类型 vtable 分派）。
     * 时间复杂度: O(1)
     */
    public Try<T, Object> fromError(Object error) {
        return Optional<T>.empty();
    }

    /**
     * 析构函数：当 Optional 包含值时自动析构 value 字段。
     * 具体 T 的析构调用由编译器在特化 __dtor 中注入。
     */
    ~Optional() {
    }
}
} // namespace std

#endif // CAY_OPTIONAL_H
