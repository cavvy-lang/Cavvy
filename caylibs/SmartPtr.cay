/**
 * SmartPtr.cay - ROADMAP 5.3.x 智能指针与资源管理
 *
 * 提供四种智能指针：
 *   - UniquePtr<T>  独占所有权，可转移、可释放
 *   - ScopedPtr<T>  作用域内独占所有权，不可转移
 *   - Rc<T>         引用计数共享所有权（原子计数，线程安全）
 *   - WeakPtr<T>    弱引用，不增加引用计数，可尝试 upgrade
 *
 * 依赖编译器在特化 __dtor 中自动注入 T 的析构与 free 调用，因此
 * UniquePtr/ScopedPtr/Rc 的析构函数体在源码层为空。
 *
 * 用法示例:
 *   scope {
 *       UniquePtr<MyClass> p = UniquePtr<MyClass>.fromRaw(new MyClass());
 *       p.get().doSomething();
 *   } // 作用域退出自动调用 MyClass.__dtor + free
 */

#pragma once

#include <Optional.cay>

namespace std {

// ============================================================
// UniquePtr<T> - 独占所有权
// ============================================================

public class UniquePtr<T> {
    /** 托管对象指针，以 long 形式存储；0 表示空。 */
    private long __owned;

    /**
     * 用对象引用构造 UniquePtr，获得该对象的所有权。
     * T 应为类类型；基本类型指针请使用 long 地址版本。
     */
    public static UniquePtr<T> fromRaw(T value) {
        UniquePtr<T> result = new UniquePtr<T>();
        long addr = 0;
        __ir {
            %v = ptrtoint i8* %value to i64
            store i64 %v, i64* %addr
        }
        result.__owned = addr;
        return result;
    }

    /**
     * 转移 other 的所有权到新的 UniquePtr，并把 other 置空。
     */
    public static UniquePtr<T> move(UniquePtr<T> other) {
        UniquePtr<T> result = new UniquePtr<T>();
        result.__owned = other.__owned;
        other.__owned = 0;
        return result;
    }

    /**
     * 获取托管对象引用（不转移所有权）。
     */
    public T get() {
        long addr = this.__owned;
        T result = null;
        __ir {
            %v = load i64, i64* %addr
            %p = inttoptr i64 %v to i8*
            store i8* %p, i8** %result
        }
        return result;
    }

    /**
     * 放弃所有权并返回对象引用；UniquePtr 本身置空。
     */
    public T release() {
        T ptr = this.get();
        this.__owned = 0;
        return ptr;
    }

    /**
     * 释放当前托管对象并把新对象设为托管对象。
     *
     * 注意：当前实现会 free 旧指针的内存，但不会调用旧对象的 __dtor
     *（源码层无法写出泛型 T 的析构调用）。若需要析构旧对象，请使用
     * `release()` 取出后手动管理，或让旧 UniquePtr 离开作用域。
     */
    public void reset(T newPtr) {
        /* 释放当前托管对象的内存（源码层无法泛型调用 T.__dtor） */
        long old = this.__owned;
        if (old != 0) {
            long o0 = old;
            __ir {
                %ov = load i64, i64* %o0
                %fp = inttoptr i64 %ov to i8*
                call void @free(i8* %fp)
            }
        }

        long addr = 0;
        __ir {
            %v = ptrtoint i8* %newPtr to i64
            store i64 %v, i64* %addr
        }
        this.__owned = addr;
    }

    /**
     * 是否持有对象。
     */
    public boolean isValid() {
        return this.__owned != 0;
    }

    /**
     * 析构函数体为空；编译器在特化 __dtor 末尾注入：
     *   if (__owned != 0) { call T.__dtor; call free; }
     */
    ~UniquePtr() {
    }
}

// ============================================================
// ScopedPtr<T> - 作用域内独占所有权（不可转移）
// ============================================================

@stack_only
public class ScopedPtr<T> {
    /** 托管对象指针，以 long 形式存储；0 表示空。 */
    private long __owned;

    /**
     * 用对象引用构造 ScopedPtr。
     */
    public static ScopedPtr<T> fromRaw(T value) {
        ScopedPtr<T> result = new ScopedPtr<T>();
        long addr = 0;
        __ir {
            %v = ptrtoint i8* %value to i64
            store i64 %v, i64* %addr
        }
        result.__owned = addr;
        return result;
    }

    /**
     * 获取托管对象引用。
     */
    public T get() {
        long addr = this.__owned;
        T result = null;
        __ir {
            %v = load i64, i64* %addr
            %p = inttoptr i64 %v to i8*
            store i8* %p, i8** %result
        }
        return result;
    }

    /**
     * 是否持有对象。
     */
    public boolean isValid() {
        return this.__owned != 0;
    }

    /**
     * 析构函数体为空；编译器注入 T.__dtor + free。
     */
    ~ScopedPtr() {
    }
}

// ============================================================
// Rc<T> - 引用计数共享所有权
// ============================================================

public class Rc<T> {
    /** 托管对象指针（冗余缓存，便于 get）。内部使用。 */
    public long __owned;
    /** 指向 24 字节控制块的指针：[i64 refcount, i64 weak_count, i64 object_ptr]。内部使用。 */
    public long __refcount_ptr;

    /**
     * 用对象引用构造 Rc，引用计数初始化为 1。
     */
    public static Rc<T> fromRaw(T value) {
        Rc<T> result = new Rc<T>();
        long owned = 0;
        __ir {
            %v = ptrtoint i8* %value to i64
            store i64 %v, i64* %owned
        }
        result.__owned = owned;

        // 分配控制块：refcount + weak_count + object_ptr
        long block = 0;
        __ir {
            %p = call i8* @calloc(i64 1, i64 24)
            %b = ptrtoint i8* %p to i64
            store i64 %b, i64* %block
        }
        result.__refcount_ptr = block;

        // 初始化 refcount = 1，weak_count = 0，object_ptr = owned
        __ir {
            %block_i64 = load i64, i64* %block
            %block_ptr = inttoptr i64 %block_i64 to i8*
            %rc_ptr = bitcast i8* %block_ptr to i64*
            store i64 1, i64* %rc_ptr

            %weak_field = getelementptr i8, i8* %block_ptr, i64 8
            %weak_field_ptr = bitcast i8* %weak_field to i64*
            store i64 0, i64* %weak_field_ptr

            %obj_field = getelementptr i8, i8* %block_ptr, i64 16
            %obj_field_ptr = bitcast i8* %obj_field to i64*
            %owned_i64 = load i64, i64* %owned
            store i64 %owned_i64, i64* %obj_field_ptr
        }
        return result;
    }

    /**
     * 创建新的 Rc 引用，原子递增引用计数。
     */
    public Rc<T> clone() {
        Rc<T> result = new Rc<T>();
        result.__owned = this.__owned;
        result.__refcount_ptr = this.__refcount_ptr;

        long rc = this.__refcount_ptr;
        __ir {
            %rc_i64 = load i64, i64* %rc
            %rc_ptr = inttoptr i64 %rc_i64 to i64*
            %old = atomicrmw add i64* %rc_ptr, i64 1 seq_cst
        }
        return result;
    }

    /**
     * 获取托管对象引用。
     */
    public T get() {
        long addr = this.__owned;
        T result = null;
        __ir {
            %v = load i64, i64* %addr
            %p = inttoptr i64 %v to i8*
            store i8* %p, i8** %result
        }
        return result;
    }

    /**
     * 返回当前引用计数（仅供调试/测试）。
     */
    public long refCount() {
        long rc = this.__refcount_ptr;
        long count = 0;
        __ir {
            %rc_i64 = load i64, i64* %rc
            %rc_ptr = inttoptr i64 %rc_i64 to i64*
            %v = load i64, i64* %rc_ptr
            store i64 %v, i64* %count
        }
        return count;
    }

    /**
     * 析构函数体为空；编译器注入 24 字节控制块 [refcount, weak_count, object_ptr] 的
     * 引用计数递减、条件析构与弱引用感知释放。
     */
    ~Rc() {
    }
}

// ============================================================
// WeakPtr<T> - 弱引用
// ============================================================

public class WeakPtr<T> {
    /** 指向 Rc 控制块的指针。 */
    private long __refcount_ptr;

    /**
     * 从 Rc 构造弱引用，不增加引用计数但递增弱引用计数。
     */
    public static WeakPtr<T> fromRc(Rc<T> rc) {
        WeakPtr<T> result = new WeakPtr<T>();
        result.__refcount_ptr = rc.__refcount_ptr;

        long rc_ptr = result.__refcount_ptr;
        __ir {
            %rc_i64 = load i64, i64* %rc_ptr
            %block_ptr = inttoptr i64 %rc_i64 to i8*
            %weak_field = getelementptr i8, i8* %block_ptr, i64 8
            %weak_field_ptr = bitcast i8* %weak_field to i64*
            %old = atomicrmw add i64* %weak_field_ptr, i64 1 seq_cst
        }
        return result;
    }

    /**
     * 检查指向的对象是否已释放。
     */
    public boolean isExpired() {
        long rc = this.__refcount_ptr;
        long count = 0;
        __ir {
            %rc_i64 = load i64, i64* %rc
            %rc_ptr = inttoptr i64 %rc_i64 to i64*
            %v = load i64, i64* %rc_ptr
            store i64 %v, i64* %count
        }
        return count == 0;
    }

    /**
     * 尝试升级弱引用为 Rc。
     * 若对象已释放，返回空 Optional；否则原子递增引用计数并返回 Rc。
     */
    public Optional<Rc<T>> upgrade() {
        long rc = this.__refcount_ptr;

        /* CAS 结果暂存栈槽：在循环外分配一次，避免重试时 alloca 反复增长栈。
           cmpxchg 返回 { i64, i1 }，而 extractvalue 不在内联 IR 白名单内，
           故把整个结果存入此槽，再把首字段按 i64 读回。 */
        long slotPtr = 0;
        __ir {
            %slot0 = alloca { i64, i1 }
            %sp0 = ptrtoint { i64, i1 }* %slot0 to i64
            store i64 %sp0, i64* %slotPtr
        }

        /* 首次读取强引用计数，作为 CAS 的期望值 */
        long expected = 0;
        __ir {
            %rc_i64_l = load i64, i64* %rc
            %rc_ptr_l = inttoptr i64 %rc_i64_l to i64*
            %v_l = load i64, i64* %rc_ptr_l
            store i64 %v_l, i64* %expected
        }

        /*
         * 「判零 + 递增」必须在同一次原子比较交换中完成。
         * 若先普通 load 判零再 atomicrmw add（原实现），两步之间其他线程可能
         * 把计数减到 0 并释放对象，导致本线程复活/访问已释放对象（TOCTOU/UAF）。
         */
        while (true) {
            if (expected == 0) {
                return Optional<Rc<T>>.empty();
            }
            long observed = 0;
            __ir {
                %rc_i64_c = load i64, i64* %rc
                %rc_ptr_c = inttoptr i64 %rc_i64_c to i64*
                %exp = load i64, i64* %expected
                %newc = add i64 %exp, 1
                %spp = load i64, i64* %slotPtr
                %slot = inttoptr i64 %spp to { i64, i1 }*
                %res = cmpxchg i64* %rc_ptr_c, i64 %exp, i64 %newc seq_cst seq_cst
                store { i64, i1 } %res, { i64, i1 }* %slot
                %slot_i64 = bitcast { i64, i1 }* %slot to i64*
                %old = load i64, i64* %slot_i64
                store i64 %old, i64* %observed
            }
            if (observed == expected) {
                break;
            }
            /* CAS 失败：计数被并发修改，用返回值作为新的期望值重试 */
            expected = observed;
        }

        // 递增成功后对象一定存活，从控制块读取 object_ptr 构造新的 Rc。
        Rc<T> result = new Rc<T>();
        result.__refcount_ptr = this.__refcount_ptr;
        long owned = 0;
        __ir {
            %rc_i64_c2 = load i64, i64* %rc
            %rc_ptr_c2 = inttoptr i64 %rc_i64_c2 to i64*
            %obj_field = getelementptr i8, i8* %rc_ptr_c2, i64 16
            %obj_field_ptr = bitcast i8* %obj_field to i64*
            %obj_i64 = load i64, i64* %obj_field_ptr
            store i64 %obj_i64, i64* %owned
        }
        result.__owned = owned;
        return Optional<Rc<T>>.of(result);
    }

    /**
     * 析构函数体为空；编译器注入弱引用计数递减。
     * 当弱引用计数归零且强引用计数为 0 时释放控制块。
     */
    ~WeakPtr() {
    }
}

} // namespace std
