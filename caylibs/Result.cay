/**
 * Result<T, E> - 显式错误传播泛型容器
 *
 * 基于 ROADMAP 6.1.x 实现。
 * 注：ROADMAP 原设计为零堆分配 tagged union；受语言当前无 union 类型
 * 限制，实现为普通堆分配 class（字段 { boolean, T, E }，O(1) 固定大小）。
 *
 * 用法示例:
 *   Result<int, String> r = Result<int, String>.ok(42);
 *   if (r.isOk()) { int v = r.unwrap(); }
 *   int v = r.unwrapOr(0);
 *   Result<long, String> r2 = r.map((int x) -> (long)x);
 *
 * 版本: 6.1.0
 */

#ifndef CAY_RESULT_H
#define CAY_RESULT_H

#include <Try.cay>

namespace std {

/**
 * Result<T, E> - 泛型结果类型
 *
 * 实现 `std::Try<T, E>`：`?` 运算符经接口分派，不再硬编码到本类。
 *
 * 时间复杂度: O(1) 所有操作
 * 空间复杂度: O(1) 固定额外空间 (boolean + T + E)
 */
public class Result<T, E> implements Try<T, E> {
    private boolean isOk;
    private T value;
    private E error;

    /**
     * 默认构造函数（私有，禁止外部直接构造）
     * 时间复杂度: O(1)
     * 空间复杂度: O(1)
     */
    private Result() {
    }

    /**
     * 创建成功结果
     * 时间复杂度: O(1)
     */
    public static Result<T, E> ok(T value) {
        Result<T, E> r = new Result<T, E>();
        r.isOk = true;
        r.value = value;
        return r;
    }

    /**
     * 创建错误结果
     * 时间复杂度: O(1)
     */
    public static Result<T, E> err(E error) {
        Result<T, E> r = new Result<T, E>();
        r.isOk = false;
        r.error = error;
        return r;
    }

    /**
     * 检查是否为成功结果
     * 时间复杂度: O(1)
     */
    public boolean isOk() {
        return this.isOk;
    }

    /**
     * 检查是否为错误结果
     * 时间复杂度: O(1)
     */
    public boolean isErr() {
        return !this.isOk;
    }

    /**
     * 获取成功值；Err 时 panic
     * 时间复杂度: O(1)
     */
    public T unwrap() {
        if (!this.isOk) {
            panic("called unwrap() on an Err Result");
        }
        return this.value;
    }

    /**
     * 获取成功值，失败时返回默认值
     * 时间复杂度: O(1)
     */
    public T unwrapOr(T defaultValue) {
        if (this.isOk) {
            return this.value;
        }
        return defaultValue;
    }

    /**
     * 获取成功值，失败时调用 handler 从错误计算出返回值
     * 时间复杂度: O(1)
     */
    public T unwrapOrElse(fn(E) -> T handler) {
        if (this.isOk) {
            return this.value;
        }
        return handler(this.error);
    }

    /**
     * 获取错误值；Ok 时 panic
     * 时间复杂度: O(1)
     */
    public E unwrapErr() {
        if (this.isOk) {
            panic("called unwrapErr() on an Ok Result");
        }
        return this.error;
    }

    // ---- std::Try<T, E> 接口实现 ----

    /**
     * Try::isOk — 成功状态查询（已由既有 isOk() 满足，此处显式声明以满足
     * 接口方法 `bool isOk()` 的返回类型 bool；既有方法返回 boolean，
     * 二者在类型系统中同为 Type::Bool，接口检查通过）。
     */

    /**
     * Try::getValue — 提取成功值（不检查状态；? 运算符在 isOk()==true 分支调用）。
     * 时间复杂度: O(1)
     */
    public T getValue() {
        return this.value;
    }

    /**
     * Try::getError — 提取失败错误（不检查状态；? 运算符在 isOk()==false 分支调用）。
     * 时间复杂度: O(1)
     */
    public E getError() {
        return this.error;
    }

    /**
     * Try::fromError — 工厂方法：从错误构造失败实例。
     * 实现约定：不访问 this（? 编译器以 null 调用，经返回类型 vtable 分派）。
     * 时间复杂度: O(1)
     */
    public Try<T, E> fromError(E error) {
        return Result<T, E>.err(error);
    }

    /**
     * 获取成功值，失败时 panic
     * 时间复杂度: O(1)
     */
    public T expect(String message) {
        if (this.isOk) {
            return this.value;
        }
        panic(message);
        return this.value;
    }

    /**
     * 映射成功值：Ok(v) -> Ok(mapper(v))，Err 原样传播
     * （实例泛型方法：U 在调用点从 lambda 推断）
     */
    public Result<U, E> map<U>(fn(T) -> U mapper) {
        if (this.isOk) {
            return Result<U, E>.ok(mapper(this.value));
        }
        return Result<U, E>.err(this.error);
    }

    /**
     * 映射错误值：Err(e) -> Err(mapper(e))，Ok 原样传播
     */
    public Result<T, F> mapErr<F>(fn(E) -> F mapper) {
        if (this.isOk) {
            return Result<T, F>.ok(this.value);
        }
        return Result<T, F>.err(mapper(this.error));
    }

    /**
     * 链式接续：Ok(v) -> handler(v)，Err 原样传播
     */
    public Result<U, E> andThen<U>(fn(T) -> Result<U, E> handler) {
        if (this.isOk) {
            return handler(this.value);
        }
        return Result<U, E>.err(this.error);
    }

    /**
     * flatMap：andThen 的别名
     */
    public Result<U, E> flatMap<U>(fn(T) -> Result<U, E> mapper) {
        return this.andThen(mapper);
    }

    /**
     * 对成功值执行副作用后原样返回（用于调试/日志）
     */
    public Result<T, E> inspect(fn(T) -> void action) {
        if (this.isOk) {
            action(this.value);
        }
        return this;
    }

    /**
     * 对错误值执行副作用后原样返回
     */
    public Result<T, E> inspectErr(fn(E) -> void action) {
        if (!this.isOk) {
            action(this.error);
        }
        return this;
    }

    /**
     * 析构函数
     */
    ~Result() {
    }
}

} // namespace std

#endif // CAY_RESULT_H
