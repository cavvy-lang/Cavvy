/**
 * Result<T, E> - 显式错误传播泛型容器
 *
 * 基于 ROADMAP 6.1.x 实现，零开销 tagged union 模式：
 * 无堆分配、无 RTTI、无栈回退。
 *
 * 用法示例:
 *   Result<int, String> r = Result<int, String>.ok(42);
 *   if (r.isOk()) { int v = r.unwrap(); }
 *   int v = r.unwrapOr(0);
 *
 * 版本: 6.1.0
 */

#ifndef CAY_RESULT_H
#define CAY_RESULT_H

namespace std {

/**
 * Result<T, E> - 泛型结果类型
 *
 * 时间复杂度: O(1) 所有操作
 * 空间复杂度: O(1) 固定额外空间 (boolean + T + E)
 */
public class Result<T, E> {
    private boolean isOk;
    private T value;
    private E error;

    /**
     * 默认构造函数（私有，禁止外部直接构造）
     * 时间复杂度: O(1)
     * 空间复杂度: O(1)
     */
    private Result() {
    }

    /**
     * 创建成功结果
     * 时间复杂度: O(1)
     */
    public static Result<T, E> ok(T value) {
        Result<T, E> r = new Result<T, E>();
        r.isOk = true;
        r.value = value;
        return r;
    }

    /**
     * 创建错误结果
     * 时间复杂度: O(1)
     */
    public static Result<T, E> err(E error) {
        Result<T, E> r = new Result<T, E>();
        r.isOk = false;
        r.error = error;
        return r;
    }

    /**
     * 检查是否为成功结果
     * 时间复杂度: O(1)
     */
    public boolean isOk() {
        return this.isOk;
    }

    /**
     * 检查是否为错误结果
     * 时间复杂度: O(1)
     */
    public boolean isErr() {
        return !this.isOk;
    }

    /**
     * 获取成功值（不安全，需先确认 isOk()）
     * 时间复杂度: O(1)
     */
    public T unwrap() {
        return this.value;
    }

    /**
     * 获取成功值，失败时返回默认值
     * 时间复杂度: O(1)
     */
    public T unwrapOr(T defaultValue) {
        if (this.isOk) {
            return this.value;
        }
        return defaultValue;
    }

    /**
     * 获取错误值（不安全，需先确认 isErr()）
     * 时间复杂度: O(1)
     */
    public E unwrapErr() {
        return this.error;
    }

    /**
     * 获取成功值，失败时 panic
     * 时间复杂度: O(1)
     */
    public T expect(String message) {
        if (this.isOk) {
            return this.value;
        }
        panic(message);
        return this.value;
    }

    /**
     * 析构函数
     */
    ~Result() {
    }
}

} // namespace std

#endif // CAY_RESULT_H
