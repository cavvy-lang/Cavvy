#ifndef CAY_STRINGBUILDER_H
#define CAY_STRINGBUILDER_H
#include <c/usual/memory.cay>

namespace std {

/* 运行时内存操作函数 */
extern {
    void __cay_memcpy_byte(long dest, long src, int n);
    void __cay_memset_byte(long ptr, int value, int n);
}

/**
 * 字符串构建器类
 * 用于高效地构建和拼接字符串
 */
public class StringBuilder {
    /* 内部缓冲区指针（long 类型以支持位运算） */
    private long buffer;
    /* 当前长度 */
    private int length;
    /* 缓冲区容量 */
    private int capacity;
    
    /* 默认初始容量 */
    private static final int DEFAULT_CAPACITY = 16;
    /* 容量增长因子 */
    private static final int GROWTH_FACTOR = 2;
    
    /* 
     * 使用 inline IR 封装 malloc/free，绕过 Cavvy 类型系统，
     * 避免与 std/ffi.cay 中 c_void* 声明冲突。
     */
    private static long __buf_alloc(int size) {
        long result;
        __ir {
            %s64 = sext i32 %size to i64
            %p = call i8* @malloc(i64 %s64)
            %v = ptrtoint i8* %p to i64
            store i64 %v, i64* %result
        }
        return result;
    }
    
    private static void __buf_free(long buf) {
        __ir {
            %p = inttoptr i64 %buf to i8*
            call void @free(i8* %p)
        }
    }
    
    /*
     * 逐字节读写助手。
     * 内联 IR 的绑定约定：函数参数名绑定到原始 SSA 值，局部变量名绑定到 alloca 指针。
     * 因此读取参数对应的内存时，必须先将其转存到局部变量，再 load 该局部变量的 alloca。
     */
    
    /**
     * 读取单字节，返回 0..255 的无符号值
     * @param addr 字节地址
     * @return 该地址处的字节值
     */
    private static int __load_byte(long addr) {
        long a = addr;
        int result = 0;
        __ir {
            %av = load i64, i64* %a
            %p = inttoptr i64 %av to i8*
            %b = load i8, i8* %p
            %v = zext i8 %b to i32
            store i32 %v, i32* %result
        }
        return result;
    }
    
    /**
     * 写入单字节（仅使用低 8 位）
     * @param addr 字节地址
     * @param value 要写入的值
     */
    private static void __store_byte(long addr, int value) {
        long a = addr;
        int v = value;
        __ir {
            %av = load i64, i64* %a
            %vv = load i32, i32* %v
            %b = trunc i32 %vv to i8
            %p = inttoptr i64 %av to i8*
            store i8 %b, i8* %p
        }
    }
    
    /**
     * 重叠安全的内存块移动（memmove 语义）
     * 当 dest < src 时按正向复制（memcpy 在重叠区间下仍然安全）；
     * 当 dest > src 且区间重叠时必须从高地址向低地址反向复制，否则会破坏源数据。
     * @param dest 目标地址
     * @param src 源地址
     * @param count 字节数
     */
    private static void __move_bytes(long dest, long src, int count) {
        if (count <= 0 || dest == src) {
            return;
        }
        if (dest < src) {
            __cay_memcpy_byte(dest, src, count);
            return;
        }
        int i = count - 1;
        while (i >= 0) {
            __store_byte(dest + i, __load_byte(src + i));
            i = i - 1;
        }
    }
    
    /**
     * 从内存块构造新 String（内容复制、NUL 结尾）
     * @param src 源地址
     * @param len 字节数（不含结尾 NUL）
     * @return 新字符串；src 为空或 len<=0 时返回空串
     */
    private static String __new_string_from_bytes(long src, int len) {
        if (src == 0 || len <= 0) {
            return "";
        }
        
        long result_ptr;
        __ir {
            %l = sext i32 %len to i64
            %size = add i64 %l, 1
            %p = call i8* @calloc(i64 1, i64 %size)
            %v = ptrtoint i8* %p to i64
            store i64 %v, i64* %result_ptr
        }
        
        if (result_ptr == 0) {
            return "";
        }
        
        __cay_memcpy_byte(result_ptr, src, len);
        __store_byte(result_ptr + (long)len, 0);
        
        String result;
        __ir {
            %rv = load i64, i64* %result_ptr
            %sp = inttoptr i64 %rv to i8*
            store i8* %sp, i8** %result
        }
        return result;
    }
    
    /* int 可表示的最大容量，容量/长度计算一律在 long 域进行以避免溢出 */
    private static final int MAX_CAPACITY = 2147483647;
    
    /**
     * 默认构造函数
     */
    public StringBuilder() {
        this.capacity = DEFAULT_CAPACITY;
        this.buffer = __buf_alloc(this.capacity);
        this.length = 0;
        /* 初始化为空字符串 */
        if (this.buffer != 0) {
            __cay_memset_byte(this.buffer, 0, 1);
        }
    }

    /**
     * 带初始容量的构造函数
     * @param initialCapacity 初始容量
     */
    public StringBuilder(int initialCapacity) {
        if (initialCapacity < 0) {
            initialCapacity = DEFAULT_CAPACITY;
        }
        this.capacity = initialCapacity;
        this.buffer = __buf_alloc(this.capacity);
        this.length = 0;
        if (this.buffer != 0) {
            __cay_memset_byte(this.buffer, 0, 1);
        }
    }
    
    /**
     * 从初始字符串构造
     * @param str 初始字符串
     */
    public StringBuilder(String str) {
        this();
        if (str != null) {
            this.append(str);
        }
    }
    
    /**
     * 析构函数，释放内存
     */
    public void finalize() {
        if (this.buffer != 0) {
            __buf_free(this.buffer);
            this.buffer = 0;
        }
    }
    
    /**
     * 确保容量足够
     * @param minCapacity 最小需要的容量
     */
    private void ensureCapacity(int minCapacity) {
        /* 如果缓冲区为空（malloc 在构造时失败），尝试重新分配 */
        if (this.buffer == 0) {
            int allocSize = minCapacity;
            if (allocSize < DEFAULT_CAPACITY) {
                allocSize = DEFAULT_CAPACITY;
            }
            this.capacity = allocSize;
            this.buffer = __buf_alloc(this.capacity);
            this.length = 0;
            if (this.buffer != 0) {
                __cay_memset_byte(this.buffer, 0, 1);
            }
            return;
        }
        
        if (minCapacity <= this.capacity) {
            return;
        }
        
        /* 计算新容量：在 long 域运算，避免 int 溢出导致死循环或越界 */
        long doubled = (long)this.capacity * (long)GROWTH_FACTOR;
        int newCapacity;
        if (doubled > (long)MAX_CAPACITY) {
            newCapacity = MAX_CAPACITY;
        } else {
            newCapacity = (int)doubled;
        }
        if (newCapacity < minCapacity) {
            newCapacity = minCapacity;
        }
        
        /* 分配新缓冲区 */
        long newBuffer = __buf_alloc(newCapacity);
        if (newBuffer == 0) {
            return; /* 内存分配失败 */
        }
        
        /* 复制旧数据 - 使用外部辅助函数 */
        if (this.length > 0 && this.buffer != 0) {
            __cay_memcpy_byte(newBuffer, this.buffer, this.length);
        }
        
        /* 释放旧缓冲区 */
        if (this.buffer != 0) {
            __buf_free(this.buffer);
        }
        
        this.buffer = newBuffer;
        this.capacity = newCapacity;
    }
    
    /**
     * 追加字符串
     * @param str 要追加的字符串
     * @return this，支持链式调用
     */
    public StringBuilder append(String str) {
        if (str == null) {
            return this.append("null");
        }
        
        int strLen = str.length();
        if (strLen == 0) {
            return this;
        }
        
        /* 确保容量足够（包括null terminator），在 long 域检测溢出 */
        long needed = (long)this.length + (long)strLen + 1L;
        if (needed > (long)MAX_CAPACITY) {
            /* 所需容量超出 int 可表示范围，无法追加，保持现有内容不变 */
            return this;
        }
        this.ensureCapacity((int)needed);
        
        /* 如果缓冲区分配失败，无法追加 */
        if (this.buffer == 0) {
            return this;
        }
        
        /* 复制字符串内容 - 使用外部辅助函数 */
        __cay_memcpy_byte(this.buffer + this.length, str.c_str(), strLen);
        
        this.length = this.length + strLen;
        
        /* 添加null terminator */
        __cay_memset_byte(this.buffer + this.length, 0, 1);
        
        return this;
    }
    
    /**
     * 追加字符
     * @param c 要追加的字符
     * @return this，支持链式调用
     */
    public StringBuilder append(char c) {
        long needed = (long)this.length + 2L;
        if (needed > (long)MAX_CAPACITY) {
            return this;
        }
        this.ensureCapacity((int)needed);
        
        /* 如果缓冲区分配失败，无法追加 */
        if (this.buffer == 0) {
            return this;
        }
        
        /* 使用外部辅助函数写入字符 */
        __cay_memset_byte(this.buffer + this.length, (int)c, 1);
        this.length = this.length + 1;
        
        /* 添加null terminator */
        __cay_memset_byte(this.buffer + this.length, 0, 1);
        
        return this;
    }
    
    /**
     * 以十进制追加长整数
     * 逐位提取时保持在负数域取模，从而正确处理 LONG_MIN（取负会溢出）。
     * @param n 要追加的长整数
     * @return this，支持链式调用
     */
    private StringBuilder __appendLongValue(long n) {
        if (n == 0) {
            return this.append('0');
        }
        
        boolean negative = n < 0L;
        /* long 最多 19 位十进制数字，符号单独处理 */
        char[] digits = new char[20]();
        int pos = 0;
        long value = n;
        while (value != 0L) {
            long digit = value % 10L;      /* 负数域：结果落在 0..-9 */
            if (digit < 0L) {
                digit = -digit;            /* 对单个十进制位取负是安全的 */
            }
            digits[pos] = (char)('0' + (int)digit);
            pos = pos + 1;
            value = value / 10L;
        }
        
        if (negative) {
            this.append('-');
        }
        
        int i = pos - 1;
        while (i >= 0) {
            this.append(digits[i]);
            i = i - 1;
        }
        
        return this;
    }
    
    /**
     * 追加整数
     * @param n 要追加的整数
     * @return this，支持链式调用
     */
    public StringBuilder append(int n) {
        return this.__appendLongValue((long)n);
    }
    
    /**
     * 追加长整数
     * @param n 要追加的长整数
     * @return this，支持链式调用
     */
    public StringBuilder append(long n) {
        return this.__appendLongValue(n);
    }
    
    /**
     * 追加布尔值
     * @param b 要追加的布尔值
     * @return this，支持链式调用
     */
    public StringBuilder append(boolean b) {
        if (b) {
            return this.append("true");
        } else {
            return this.append("false");
        }
    }
    
    /**
     * 追加字符数组
     * @param chars 要追加的字符数组
     * @return this，支持链式调用
     */
    public StringBuilder append(char[] chars) {
        if (chars == null) {
            return this.append("null");
        }
        
        int len = chars.length;
        int i = 0;
        while (i < len) {
            this.append(chars[i]);
            i = i + 1;
        }
        
        return this;
    }
    
    /**
     * 追加换行符
     * @return this，支持链式调用
     */
    public StringBuilder appendln() {
        return this.append('\n');
    }
    
    /**
     * 追加字符串并添加换行符
     * @param str 要追加的字符串
     * @return this，支持链式调用
     */
    public StringBuilder appendln(String str) {
        this.append(str);
        return this.append('\n');
    }
    
    /**
     * 获取当前长度
     * @return 字符串长度
     */
    public int length() {
        return this.length;
    }
    
    /**
     * 获取当前容量
     * @return 缓冲区容量
     */
    public int capacity() {
        return this.capacity;
    }
    
    /**
     * 检查是否为空
     * @return true如果长度为0
     */
    public boolean isEmpty() {
        return this.length == 0;
    }
    
    /**
     * 清空字符串构建器
     * @return this，支持链式调用
     */
    public StringBuilder clear() {
        this.length = 0;
        if (this.buffer != 0) {
            __cay_memset_byte(this.buffer, 0, 1);
        }
        return this;
    }
    
    /**
     * 转换为字符串
     * @return 构建的字符串
     */
    public String toString() {
        if (this.length == 0 || this.buffer == 0) {
            return "";
        }
        return __new_string_from_bytes(this.buffer, this.length);
    }
    
    /**
     * 获取指定位置的字符
     * @param index 索引
     * @return 字符
     */
    public char charAt(int index) {
        if (index < 0 || index >= this.length || this.buffer == 0) {
            return '\0';
        }
        return (char)__load_byte(this.buffer + index);
    }
    
    /**
     * 删除指定范围的字符
     * @param start 起始索引（包含）
     * @param end 结束索引（不包含）
     * @return this，支持链式调用
     */
    public StringBuilder delete(int start, int end) {
        if (this.buffer == 0) {
            return this;
        }
        if (start < 0) {
            start = 0;
        }
        if (end > this.length) {
            end = this.length;
        }
        if (start >= end) {
            return this;
        }
        
        int deleteLen = end - start;
        int moveLen = this.length - end;

        /* 移动后面的字符（区间可能重叠，使用 memmove 语义） */
        if (moveLen > 0) {
            __move_bytes(this.buffer + start, this.buffer + end, moveLen);
        }

        this.length = this.length - deleteLen;

        /* 更新null terminator */
        __store_byte(this.buffer + this.length, 0);

        return this;
    }
    
    /**
     * 在指定位置插入字符串
     * @param offset 插入位置
     * @param str 要插入的字符串
     * @return this，支持链式调用
     */
    public StringBuilder insert(int offset, String str) {
        if (offset < 0) {
            offset = 0;
        }
        if (offset > this.length) {
            offset = this.length;
        }
        
        if (str == null) {
            str = "null";
        }
        
        int strLen = str.length();
        if (strLen == 0) {
            return this;
        }
        
        /* 确保容量（包括null terminator），在 long 域检测溢出 */
        long needed = (long)this.length + (long)strLen + 1L;
        if (needed > (long)MAX_CAPACITY) {
            return this;
        }
        this.ensureCapacity((int)needed);

        /* 如果缓冲区分配失败，无法插入 */
        if (this.buffer == 0) {
            return this;
        }

        /* 移动后面的字符（目标区间在源区间之后，区间可能重叠） */
        int moveLen = this.length - offset;
        if (moveLen > 0) {
            __move_bytes(this.buffer + offset + strLen, this.buffer + offset, moveLen);
        }

        /* 插入新字符串 - 使用外部辅助函数 */
        __cay_memcpy_byte(this.buffer + offset, str.c_str(), strLen);

        this.length = this.length + strLen;

        /* 更新null terminator */
        __store_byte(this.buffer + this.length, 0);

        return this;
    }
    
    /**
     * 反转字符串
     * @return this，支持链式调用
     */
    public StringBuilder reverse() {
        if (this.length <= 1 || this.buffer == 0) {
            return this;
        }
        
        int left = 0;
        int right = this.length - 1;
        
        while (left < right) {
            int lv = __load_byte(this.buffer + left);
            int rv = __load_byte(this.buffer + right);
            __store_byte(this.buffer + left, rv);
            __store_byte(this.buffer + right, lv);

            left = left + 1;
            right = right - 1;
        }
        
        return this;
    }
    
    /**
     * 设置长度（截断或扩展）
     * @param newLength 新长度
     */
    public void setLength(int newLength) {
        if (newLength < 0) {
            return;
        }
        
        if (this.buffer == 0) {
            return;
        }
        
        if (newLength > this.length) {
            /* 扩展 - 在 long 域检测容量溢出 */
            long needed = (long)newLength + 1L;
            if (needed > (long)MAX_CAPACITY) {
                return;
            }
            this.ensureCapacity((int)needed);
            if (this.buffer == 0) {
                return;
            }
            /* 填充 NUL 字符 */
            int i = this.length;
            while (i < newLength) {
                __store_byte(this.buffer + i, 0);
                i = i + 1;
            }
        }

        this.length = newLength;

        /* 更新null terminator */
        if (this.buffer != 0) {
            __store_byte(this.buffer + this.length, 0);
        }
    }
    
    /**
     * 截取子字符串
     * @param start 起始索引
     * @return 子字符串
     */
    public String substring(int start) {
        return this.substring(start, this.length);
    }
    
    /**
     * 截取子字符串
     * @param start 起始索引（包含）
     * @param end 结束索引（不包含）
     * @return 子字符串
     */
    public String substring(int start, int end) {
        if (start < 0) {
            start = 0;
        }
        if (end > this.length) {
            end = this.length;
        }
        if (start >= end) {
            return "";
        }
        
        if (this.buffer == 0) {
            return "";
        }
        
        return __new_string_from_bytes(this.buffer + start, end - start);
    }
    
    /**
     * 查找子串首次出现的位置
     * @param str 要查找的子串
     * @return 索引位置，-1表示未找到
     */
    public int indexOf(String str) {
        if (str == null || this.length == 0) {
            return -1;
        }
        
        if (this.buffer == 0) {
            return -1;
        }
        
        int strLen = str.length();
        if (strLen == 0) {
            return 0;
        }
        if (strLen > this.length) {
            return -1;
        }
        
        int i = 0;
        while (i <= this.length - strLen) {
            int j = 0;
            while (j < strLen) {
                char c1 = (char)__load_byte(this.buffer + i + j);
                char c2 = str.charAt(j);
                if (c1 != c2) {
                    break;
                }
                j = j + 1;
            }
            if (j == strLen) {
                return i;
            }
            i = i + 1;
        }
        
        return -1;
    }
    
    /**
     * 替换所有出现的子串
     * @param target 目标子串
     * @param replacement 替换内容
     * @return this，支持链式调用
     */
    public StringBuilder replace(String target, String replacement) {
        if (target == null || replacement == null || this.length == 0) {
            return this;
        }
        
        int targetLen = target.length();
        int replacementLen = replacement.length();
        
        if (targetLen == 0) {
            return this;
        }
        
        /* 简单实现：转换为字符串，替换，再设置回来 */
        String current = this.toString();
        String result = current.replace(target, replacement);
        
        this.clear();
        this.append(result);
        
        return this;
    }
    
    /**
     * 获取内部缓冲区指针（用于FFI）
     * @return C字符串指针
     */
    public long c_str() {
        return this.buffer;
    }
    
    /**
     * 从C字符串指针创建StringBuilder
     * @param ptr C字符串指针
     * @return StringBuilder实例
     */
    public static StringBuilder fromCString(long ptr) {
        StringBuilder sb = new StringBuilder();
        if (ptr == 0) {
            return sb;
        }
        
        /* 复制C字符串内容 */
        int i = 0;
        while (true) {
            int ci = __load_byte(ptr + i);
            if (ci == 0) {
                break;
            }
            sb.append((char)ci);
            i = i + 1;
        }
        
        return sb;
    }
}

} // namespace std

#endif /* CAY_STRINGBUILDER_H */
