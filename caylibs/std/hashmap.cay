/*
 * Cavvy 哈希表标准库 - 0.5.2.x
 *
 * 泛型单态化实现：HashMap<K, V, A: Allocator = GlobalAlloc>
 * 采用开放寻址法（带删除标记），负载因子 0.7。
 *
 * 当前要求键类型 K 提供：
 *   int hashCode()
 *   bool equals(K other)
 */

#pragma once

#include <Allocator.cay>
#include <std/iterator.cay>
#include <std/arraylist.cay>

namespace std {

/**
 * HashMap 键值对迭代器。
 */
public final class HashMapIterator<K, V> implements Iterator<K> {
    private K[] keys;
    private V[] values;
    private char[] states;
    private int capacity;
    private int index;

    public HashMapIterator(K[] keys, V[] values, char[] states, int capacity) {
        this.keys = keys;
        this.values = values;
        this.states = states;
        this.capacity = capacity;
        this.index = 0;
    }

    public bool hasNext() {
        while (this.index < this.capacity) {
            if (this.states[this.index] == 1) {
                return true;
            }
            this.index = this.index + 1;
        }
        return false;
    }

    public K next() {
        while (this.index < this.capacity) {
            if (this.states[this.index] == 1) {
                K key = this.keys[this.index];
                this.index = this.index + 1;
                return key;
            }
            this.index = this.index + 1;
        }
        return this.keys[0];
    }
}

/**
 * 泛型哈希表。
 */
public class HashMap<K, V, A: Allocator = GlobalAlloc> {
    private K[] keys;
    private V[] values;
    private char[] states;
    private int size;
    private int capacity;
    private A allocator;
    /* 三个数组的分配基址（__cay_array_base），用于经 allocator 归还内存 */
    private long keysBuf;
    private long valuesBuf;
    private long statesBuf;

    private static final float LOAD_FACTOR = 0.7f;
    private static final char EMPTY = 0;
    private static final char OCCUPIED = 1;
    private static final char DELETED = 2;

    public HashMap() {
        this.allocator = new A();
        this.capacity = 8;
        this.keysBuf = 0;
        this.valuesBuf = 0;
        this.statesBuf = 0;
        this.allocArrays();
        this.size = 0;
    }

    public HashMap(int initialCapacity) {
        this.allocator = new A();
        if (initialCapacity < 1) {
            initialCapacity = 1;
        }
        this.capacity = this.nextPowerOfTwo(initialCapacity);
        this.keysBuf = 0;
        this.valuesBuf = 0;
        this.statesBuf = 0;
        this.allocArrays();
        this.size = 0;
    }

    public HashMap(A allocator) {
        this.allocator = allocator;
        this.capacity = 8;
        this.keysBuf = 0;
        this.valuesBuf = 0;
        this.statesBuf = 0;
        this.allocArrays();
        this.size = 0;
    }

    /**
     * 经分配器申请三个数组，并记录分配基址供析构时归还。
     *
     * 三个数组都通过 __cay_alloc_array 走 `this.allocator`，因此
     * `HashMap(A allocator)` 的分配器参数是真实生效的。
     */
    private void allocArrays() {
        this.keys = __cay_alloc_array<K>(this.allocator, this.capacity);
        this.keysBuf = __cay_array_base(this.keys);
        this.values = __cay_alloc_array<V>(this.allocator, this.capacity);
        this.valuesBuf = __cay_array_base(this.values);
        this.states = __cay_alloc_array<char>(this.allocator, this.capacity);
        this.statesBuf = __cay_array_base(this.states);
    }

    /**
     * 归还三个数组的分配基址。
     */
    private void freeArrays() {
        this.freeBuffer(this.keysBuf);
        this.freeBuffer(this.valuesBuf);
        this.freeBuffer(this.statesBuf);
        this.keysBuf = 0;
        this.valuesBuf = 0;
        this.statesBuf = 0;
    }

    /**
     * 归还一个分配基址（0 表示无需归还）。
     */
    private void freeBuffer(long base) {
        if (base != 0) {
            this.allocator.deallocate(base);
        }
    }

    public int size() {
        return this.size;
    }

    public bool isEmpty() {
        return this.size == 0;
    }

    public void clear() {
        for (int i = 0; i < this.capacity; i = i + 1) {
            this.states[i] = EMPTY;
        }
        this.size = 0;
    }

    public void put(@owns K key, @owns V value) {
        /* 用 long 计算负载阈值与扩容目标，避免 int 乘法溢出 */
        long threshold = ((long)this.capacity * 7L) / 10L; /* LOAD_FACTOR = 0.7 */
        if ((long)this.size + 1L > threshold) {
            long newCapacity = (long)this.capacity * 2L;
            if (newCapacity > 1073741824L) { /* 2^30，防止 *2 溢出为负 */
                newCapacity = 1073741824L;
            }
            this.resize((int)newCapacity);
        }

        int index = this.findInsertIndex(key);
        if (this.states[index] != OCCUPIED) {
            this.size = this.size + 1;
        }
        this.keys[index] = key;
        this.values[index] = value;
        this.states[index] = OCCUPIED;
    }

    public V get(K key) {
        int index = this.findIndex(key);
        if (index < 0) {
            return this.values[0];
        }
        return this.values[index];
    }

    public bool containsKey(K key) {
        return this.findIndex(key) >= 0;
    }

    public void remove(K key) {
        int index = this.findIndex(key);
        if (index >= 0) {
            this.states[index] = DELETED;
            this.size = this.size - 1;
        }
    }

    public ArrayList<K> keySet() {
        ArrayList<K> list = new ArrayList<K>(this.size);
        for (int i = 0; i < this.capacity; i = i + 1) {
            if (this.states[i] == OCCUPIED) {
                list.add(this.keys[i]);
            }
        }
        return list;
    }

    public ArrayList<V> values() {
        ArrayList<V> list = new ArrayList<V>(this.size);
        for (int i = 0; i < this.capacity; i = i + 1) {
            if (this.states[i] == OCCUPIED) {
                list.add(this.values[i]);
            }
        }
        return list;
    }

    public Iterator<K> iterator() {
        return new HashMapIterator<K, V>(this.keys, this.values, this.states, this.capacity);
    }

    /**
     * 析构函数：按 states 门控析构键值，并释放三个内部数组。
     *
     * 必须按状态遍历，不能用 __cay_destroy_array —— 槽位有 EMPTY/OCCUPIED/
     * DELETED 三态，非 OCCUPIED 槽位的内容可能是陈旧值，逐个析构会二次析构。
     */
    ~HashMap() {
        if (this.states != null) {
            for (int i = 0; i < this.capacity; i = i + 1) {
                if (this.states[i] == OCCUPIED) {
                    __cay_destroy<K>(this.keys[i]);
                    __cay_destroy<V>(this.values[i]);
                }
            }
            this.freeArrays();
        }
    }


    private int hash(K key) {
        /* 清零符号位：对 INT_MIN 取负会溢出仍为负，导致后续取模得到负索引。
           位与 0x7FFFFFFF 对任何 int 都可得到非负结果。 */
        int h = key.hashCode() & 2147483647;
        return h;
    }

    private bool keyEquals(K a, K b) {
        return a.equals(b);
    }

    private int findIndex(K key) {
        int h = this.hash(key);
        int index = h % this.capacity;
        for (int i = 0; i < this.capacity; i = i + 1) {
            char state = this.states[index];
            if (state == EMPTY) {
                return -1;
            }
            if (state == OCCUPIED && this.keyEquals(this.keys[index], key)) {
                return index;
            }
            index = (index + 1) % this.capacity;
        }
        return -1;
    }

    private int findInsertIndex(K key) {
        int h = this.hash(key);
        int index = h % this.capacity;
        int firstDeleted = -1;
        for (int i = 0; i < this.capacity; i = i + 1) {
            char state = this.states[index];
            if (state == EMPTY) {
                if (firstDeleted >= 0) {
                    return firstDeleted;
                }
                return index;
            }
            if (state == OCCUPIED && this.keyEquals(this.keys[index], key)) {
                return index;
            }
            if (state == DELETED && firstDeleted < 0) {
                firstDeleted = index;
            }
            index = (index + 1) % this.capacity;
        }
        if (firstDeleted >= 0) {
            return firstDeleted;
        }
        return index;
    }

    private void resize(int newCapacity) {
        if (newCapacity < 8) {
            newCapacity = 8;
        }
        int oldCapacity = this.capacity;
        K[] oldKeys = this.keys;
        V[] oldValues = this.values;
        char[] oldStates = this.states;

        /* 旧数组的分配基址必须先留存：allocArrays 会覆盖三个 *_Buf 字段，
           而重哈希仍要从 oldKeys/oldValues 读取，因此只能在重哈希完成后释放。 */
        long oldKeysBuf = this.keysBuf;
        long oldValuesBuf = this.valuesBuf;
        long oldStatesBuf = this.statesBuf;

        this.capacity = this.nextPowerOfTwo(newCapacity);
        this.keysBuf = 0;
        this.valuesBuf = 0;
        this.statesBuf = 0;
        this.allocArrays();
        this.size = 0;

        for (int i = 0; i < oldCapacity; i = i + 1) {
            if (oldStates[i] == OCCUPIED) {
                this.put(oldKeys[i], oldValues[i]);
            }
        }

        this.freeBuffer(oldKeysBuf);
        this.freeBuffer(oldValuesBuf);
        this.freeBuffer(oldStatesBuf);
    }

    private int nextPowerOfTwo(int n) {
        if (n < 1) {
            return 1;
        }
        /* 用 long 累乘，避免 n > 2^30 时 power * 2 溢出为负导致死循环 */
        long power = 1;
        while (power < (long)n) {
            power = power * 2L;
        }
        if (power > 1073741824L) {
            return 1073741824;
        }
        return (int)power;
    }
}

} // namespace std
