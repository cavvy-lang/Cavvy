/*
 * Cavvy 动态数组标准库 - 0.5.2.x
 *
 * 泛型单态化实现：ArrayList<T, A: Allocator = GlobalAlloc>
 *
 * 内部存储通过编译器内建表达式 __cay_alloc_array<T>(allocator, count)
 * 向分配器 A 申请内存，数据指针前 8 字节为 [i32 length][i32 padding]。
 * 析构时通过 __cay_array_base(data) 回退到分配基址，调用 allocator.deallocate
 * 释放 backing buffer。
 */

#pragma once

#include <Allocator.cay>
#include <std/iterator.cay>

namespace std {

/**
 * ArrayList 迭代器实现。
 *
 * 创建时快照当前 data 数组与有效长度，因此遍历期间对列表的结构性修改
 * 不会反映到迭代器上（与 std::vector 迭代器行为一致）。
 */
public final class ArrayListIterator<T> implements Iterator<T>, MutableRandomAccessIterator<T> {
    private T[] data;
    private int size;
    private int index;

    public ArrayListIterator(T[] data, int size) {
        this.data = data;
        this.size = size;
        this.index = 0;
    }

    public bool hasNext() {
        return this.index < this.size;
    }

    public @borrow T next() {
        T value = this.data[this.index];
        this.index = this.index + 1;
        return value;
    }

    public int length() { return this.size; }
    public @borrow T get(int index) { return this.data[index]; }
    public void set(int index, T value) { this.data[index] = value; }

}

/**
 * 动态数组，支持泛型类型参数 T 与分配器参数 A。
 *
 * 默认分配器为 GlobalAlloc。API 风格贴近 Java ArrayList，同时保留
 * `reserve`/`trimToSize` 等 C++ 风格命名以方便迁移。
 */
public final class ArrayList<T, A: Allocator = GlobalAlloc> implements Iterable<T> {
    private T[] data;
    private int size;
    private A allocator;
    private long buffer;
    /**
     * 是否拥有元素的析构责任。普通列表为 true；`HashMap.keySet()/values()`
     * 返回的借用视图为 false —— 元素仍归源容器所有，视图只借用引用。
     */
    private bool ownsElements;

    /**
     * 默认构造，使用 GlobalAlloc。内部预留 1 个槽位，避免空列表时
     * 越界回退访问到未分配内存。
     */
    public ArrayList() {
        this.allocator = new A();
        this.buffer = 0;
        this.ownsElements = true;
        this.allocate(1);
        this.size = 0;
    }

    /**
     * 指定初始容量，使用 GlobalAlloc。
     */
    public ArrayList(int initialCapacity) {
        if (initialCapacity < 1) {
            initialCapacity = 1;
        }
        this.allocator = new A();
        this.buffer = 0;
        this.ownsElements = true;
        this.allocate(initialCapacity);
        this.size = 0;
    }

    /**
     * 指定分配器。
     */
    public ArrayList(A allocator) {
        this.allocator = allocator;
        this.buffer = 0;
        this.ownsElements = true;
        this.allocate(1);
        this.size = 0;
    }

    /**
     * 指定初始容量与分配器。
     */
    public ArrayList(int initialCapacity, A allocator) {
        if (initialCapacity < 1) {
            initialCapacity = 1;
        }
        this.allocator = allocator;
        this.buffer = 0;
        this.ownsElements = true;
        this.allocate(initialCapacity);
        this.size = 0;
    }

    /**
     * 内部/借用视图构造函数：`ownsElements == false` 时不析构元素，
     * 元素生命周期仍由源容器管理。仅供 `HashMap.keySet()/values()` 等
     * 只读视图使用；借用视图拒绝 `add`/`set` 等会改变元素所有权的操作。
     */
    public ArrayList(int initialCapacity, bool ownsElements) {
        if (initialCapacity < 1) {
            initialCapacity = 1;
        }
        this.allocator = new A();
        this.buffer = 0;
        this.ownsElements = ownsElements;
        this.allocate(initialCapacity);
        this.size = 0;
    }

    /**
     * 静态工厂：创建包含 count 个 value 的一维 ArrayList。
     *
     * 注意：对对象类型元素，该方法执行浅拷贝（保存同一个对象指针），
     * 因此推荐仅用于原始类型（int/long/double/bool 等）。
     */
    public static ArrayList<T> filled(int count, T value) {
        ArrayList<T> list = new ArrayList<T>();
        for (int i = 0; i < count; i = i + 1) {
            list.add(value);
        }
        return list;
    }

    /**
     * 析构函数：释放 backing buffer，并递归析构元素对象。
     *
     * 编译器会在调用用户编写的析构体之前，自动为 ArrayList<T> 注入元素
     * 析构逻辑：遍历 this.data[0..this.size)，对每个元素调用其 __dtor。
     * 这样嵌套 ArrayList 会在外层析构时递归释放内层对象，避免内存泄漏。
     *
     * 安全性前提：调用方把局部对象 add 进 ArrayList 后，编译器会自动将该
     * 局部变量从作用域析构候选中移除（所有权转移），防止 double-free。
     */
    ~ArrayList() {
        if (this.buffer != 0) {
            /* 先析构元素：data[0..size) 是密集存储，每个槽位都是有效元素；
               T 为原始类型 / struct 时 __cay_destroy_array 编译期展开为空操作。
               必须在释放 backing buffer 之前完成，否则会访问已释放内存。 */
            if (this.ownsElements) {
                __cay_destroy_array<T>(this.data, this.size);
            }
            this.allocator.deallocate(this.buffer);
            this.buffer = 0;
        }
    }

    /**
     * 向分配器申请容量为 capacity 的 backing buffer。
     */
    private void allocate(int capacity) {
        this.data = __cay_alloc_array<T>(this.allocator, capacity);
        this.buffer = __cay_array_base(this.data);
    }

    /**
     * 确保容量至少为 minCapacity。容量按 2 倍增长，直到满足需求。
     */
    public void ensureCapacity(int minCapacity) {
        if (minCapacity <= this.data.length) {
            return;
        }

        /* 用 long 累乘，避免容量翻倍时 int 溢出为负导致死循环 */
        long newCapacity = (long)this.data.length;
        if (newCapacity < 1L) {
            newCapacity = 1L;
        }
        while (newCapacity < (long)minCapacity) {
            newCapacity = newCapacity * 2L;
        }
        if (newCapacity > 2147483647L) {
            newCapacity = 2147483647L;
        }

        this.reallocate((int)newCapacity);
    }

    /**
     * 预分配容量（ensureCapacity 的别名）。
     */
    public void reserve(int capacity) {
        this.ensureCapacity(capacity);
    }

    /**
     * 追加元素到末尾。
     */
    public void add(@owns T value) {
        if (!this.ownsElements) {
            /* 借用视图不接管元素所有权；仍然必须履行 @owns 的“失败即析构”
               义务，避免调用方已摘除析构候选后对象泄漏。 */
            __cay_destroy<T>(value);
            return;
        }
        this.ensureCapacity(this.size + 1);
        this.data[this.size] = value;
        this.size = this.size + 1;
    }

    /**
     * 在指定索引处插入元素。index 范围 [0, size]。
     *
     * 索引非法时本方法已经通过 `@owns` 取得 value 的所有权，因此必须就地
     * 析构 value，否则调用方摘除析构候选后该对象会泄漏。
     */
    public void add(int index, @owns T value) {
        if (!this.ownsElements || index < 0 || index > this.size) {
            __cay_destroy<T>(value);
            return;
        }
        this.ensureCapacity(this.size + 1);
        for (int i = this.size; i > index; i = i - 1) {
            this.data[i] = this.data[i - 1];
        }
        this.data[index] = value;
        this.size = this.size + 1;
    }

    /**
     * 仅供借用视图（`ownsElements == false`）登记元素引用。不取得所有权，
     * 借用视图也不会析构它。对普通列表调用为空操作，防止同一对象出现两个所有者。
     */
    public void addBorrowed(T value) {
        if (this.ownsElements) {
            return;
        }
        this.ensureCapacity(this.size + 1);
        this.data[this.size] = value;
        this.size = this.size + 1;
    }

    /**
     * 将另一个列表的所有元素追加到末尾。
     */
    public void addAll(ArrayList<T> other) {
        this.addAll(this.size, other);
    }

    /**
     * 将另一个列表的所有元素插入到指定索引处。index 范围 [0, size]。
     */
    public void addAll(int index, ArrayList<T> other) {
        if (other == null) {
            return;
        }
        if (index < 0 || index > this.size) {
            return;
        }

        int otherSize = other.size();
        if (otherSize <= 0) {
            return;
        }

        /* 先快照 other 的元素，避免 this 与 other 是同一对象时
         * 搬移过程中读错数据。 */
        T[] temp = new T[otherSize];
        for (int i = 0; i < otherSize; i = i + 1) {
            temp[i] = other.get(i);
        }

        this.ensureCapacity(this.size + otherSize);
        for (int i = this.size - 1; i >= index; i = i - 1) {
            this.data[i + otherSize] = this.data[i];
        }
        for (int i = 0; i < otherSize; i = i + 1) {
            this.data[index + i] = temp[i];
        }
        this.size = this.size + otherSize;
    }

    /**
     * 获取指定位置元素。index 越界时返回 data[0]（预留槽位，值为零/空）。
     */
    public @borrow T get(int index) {
        if (index < 0 || index >= this.size) {
            return this.data[0];
        }
        return this.data[index];
    }

    /**
     * 替换指定位置元素。新值经 `@owns` 转移给列表，旧元素先被析构。
     * index 越界或列表为借用视图时，value 已被本方法接管，必须就地析构。
     */
    public void set(int index, @owns T value) {
        if (!this.ownsElements || index < 0 || index >= this.size) {
            __cay_destroy<T>(value);
            return;
        }
        __cay_destroy<T>(this.data[index]);
        this.data[index] = value;
    }

    /**
     * 内部搬移：直接写入槽位，不析构旧值，也不取得新值的所有权。
     *
     * Queue/Deque 的死区置零、compact 搬移与 PriorityQueue 的 swap/pop
     * 都要求“移动”而不是“替换+析构”，否则会把已经返回给调用方或
     * 即将返回的元素提前析构。
     */
    public void moveAt(int index, T value) {
        if (index < 0 || index >= this.size) {
            return;
        }
        this.data[index] = value;
    }

    /**
     * 返回元素数量。
     */
    public int size() {
        return this.size;
    }

    /**
     * 返回当前容量。
     */
    public int capacity() {
        return this.data.length;
    }

    /**
     * 是否为空。
     */
    public bool isEmpty() {
        return this.size == 0;
    }

    /**
     * 清空列表。容量保持不变。
     */
    public void clear() {
        if (this.ownsElements) {
            /* 必须先析构元素再清零 size：析构函数只遍历 [0, size)，
               先清零会让被清掉的元素永远无法回收。 */
            __cay_destroy_array<T>(this.data, this.size);
        }
        this.size = 0;
    }

    /**
     * 移除并返回指定索引处的元素。index 越界时返回 data[0]。
     */
    public T remove(int index) {
        if (index < 0 || index >= this.size) {
            return this.data[0];
        }
        T value = this.data[index];
        for (int i = index; i < this.size - 1; i = i + 1) {
            this.data[i] = this.data[i + 1];
        }
        this.size = this.size - 1;
        return value;
    }

    /**
     * 移除第一个与 value 相等的元素。相等性使用 `==` 判断：
     * 对 primitive 为值比较，对对象/字符串为引用比较。
     *
     * 命名为 removeValue 而非 remove(T)，避免与 remove(int index) 在
     * T = int 时产生无法区分的方法重载，并规避泛型单态化 vtable 命名冲突。
     */
    public void removeValue(T value) {
        int index = this.indexOf(value);
        if (index >= 0) {
            T removed = this.remove(index);
            /* remove() 把元素所有权交还给调用方；removeValue 的语义是丢弃，
               因此必须在这里析构，否则对象泄漏。 */
            __cay_destroy<T>(removed);
        }
    }

    /**
     * 移除并返回末尾元素。列表为空时返回 data[0]。
     */
    public T removeLast() {
        if (this.size <= 0) {
            return this.data[0];
        }
        this.size = this.size - 1;
        return this.data[this.size];
    }

    /**
     * 返回 value 第一次出现的索引，未找到返回 -1。
     */
    public int indexOf(T value) {
        for (int i = 0; i < this.size; i = i + 1) {
            if (this.data[i] == value) {
                return i;
            }
        }
        return -1;
    }

    /**
     * 返回 value 最后一次出现的索引，未找到返回 -1。
     */
    public int lastIndexOf(T value) {
        for (int i = this.size - 1; i >= 0; i = i - 1) {
            if (this.data[i] == value) {
                return i;
            }
        }
        return -1;
    }

    /**
     * 是否包含 value。
     */
    public bool contains(T value) {
        return this.indexOf(value) >= 0;
    }

    /**
     * 将容量收缩到与元素数量相等。若列表为空则容量保持为 1。
     */
    public void trimToSize() {
        if (this.size != this.data.length) {
            this.reallocate(this.size);
        }
    }

    /**
     * 返回包含当前所有元素的新数组（长度为 size）。
     * 该数组使用全局 calloc 分配，作为独立副本由调用者持有。
     */
    public T[] toArray() {
        T[] result = new T[this.size];
        for (int i = 0; i < this.size; i = i + 1) {
            result[i] = this.data[i];
        }
        return result;
    }

    /**
     * 返回迭代器。
     */
    public Iterator<T> iterator() {
        return new ArrayListIterator<T>(this.data, this.size);
    }


    public MutableRandomAccessIterator<T> mutableIterator() {
        return new ArrayListIterator<T>(this.data, this.size);
    }


    /**
     * 重新分配内部数组。newCapacity 至少为 1。
     */
    private void reallocate(int newCapacity) {
        if (newCapacity < 1) {
            newCapacity = 1;
        }

        long oldBuffer = this.buffer;
        T[] oldData = this.data;
        int oldSize = this.size;

        this.allocate(newCapacity);

        int limit = oldSize;
        if (limit > newCapacity) {
            limit = newCapacity;
        }
        for (int i = 0; i < limit; i = i + 1) {
            this.data[i] = oldData[i];
        }
        this.size = limit;

        if (oldBuffer != 0) {
            this.allocator.deallocate(oldBuffer);
        }
    }
}

} // namespace std
