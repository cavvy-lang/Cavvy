
public class GoLLib {
    public static int countNeighbors(int[][] grid, int x, int y) {
        int count = 0;
        for (int dx = -1; dx <= 1; dx = dx + 1) {
            for (int dy = -1; dy <= 1; dy = dy + 1) {
                if (dx != 0 || dy != 0) {
                    int nx = x + dx;
                    int ny = y + dy;
                    if (nx >= 0 && nx < grid.length && ny >= 0 && ny < grid[0].length) {
                        count = count + grid[nx][ny];
                    }
                }
            }
        }
        return count;
    }
}
