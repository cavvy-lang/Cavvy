
public class Student {
    public int id;
    public String name;
    public int score;
    public Student(int i, String n, int s) {
        this.id = i;
        this.name = n;
        this.score = s;
    }
    public String getGrade() {
        if (this.score >= 90) { return "A"; }
        else if (this.score >= 80) { return "B"; }
        else if (this.score >= 70) { return "C"; }
        else { return "D"; }
    }
}
