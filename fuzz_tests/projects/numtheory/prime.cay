
public class PrimeUtils {
    public static boolean isPrime(int n) {
        if (n < 2) { return false; }
        for (int i = 2; i * i <= n; i = i + 1) {
            if (n % i == 0) { return false; }
        }
        return true;
    }
    public static int gcd(int a, int b) {
        while (b != 0) {
            int t = b;
            b = a % b;
            a = t;
        }
        return a;
    }
    public static int lcm(int a, int b) {
        return (a / gcd(a, b)) * b;
    }
}
