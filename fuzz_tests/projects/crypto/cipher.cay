
public class Cipher {
    public static String caesarEncrypt(String s, int shift) {
        String result = "";
        for (int i = 0; i < s.length(); i = i + 1) {
            char c = s.charAt(i);
            if (c >= 'A' && c <= 'Z') {
                c = (char)(((int)(c - 'A') + shift) % 26 + (int)'A');
            }
            result = result + c;
        }
        return result;
    }
}
