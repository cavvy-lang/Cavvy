// Fuzz Test: if_else_chains // Fuzz16_087_LOTKF
public class Fuzz16_087_LOTKF {
    public static void test_if_000() {
        int x = 10;
        if(x>0){println("pos");}else{println("nonpos");}
        int y = -35;
        if(y>0 && x>0){println("both pos");} else if(y<0 && x<0){println("both neg");} else {println("mixed");}
        println("OK");
    }
