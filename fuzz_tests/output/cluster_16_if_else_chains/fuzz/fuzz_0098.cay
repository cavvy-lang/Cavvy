    public static void test_if_000() {
        int x = -6;
        if(x<0){println("neg");}else{println("nonneg");}
        int y = -21;
        if(y>0 && x>0){println("both pos");} else if(y<0 && x<0){println("both neg");} else {println("mixed");}
        println("OK");
    }
