// Fuzz Test: break_continue // Fuzz22_081_ZFILS
public class Fuzz22_081_ZFILS {
    public static void test_brk_000() {
        for(int i=0;i<5;i=i+1){if(i==2) break; println(i);}
        println("--");
        for(int i=0;i<5;i=i+1){if(i%2==0) continue; println(i);}
        println("OK");
    }
    public static void test_brk_001() {
        for(int i=0;i<7;i=i+1){if(i==3) break; println(i);}
        println("--");
        for(int i=0;i<7;i=i+1){if(i%2==0) continue; println(i);}
        println("OK");
    }
    public static void test_brk_002() {
        for(int i=0;i<13;i=i+1){if(i==6) break; println(i);}
        println("--");
        for(int i=0;i<13;i=i+1){if(i%2==0) continue; println(i);}
        println("OK");
    }
