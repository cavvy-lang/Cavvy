// Fuzz Test: number_literals // Fuzz09_042_SWEHG
public class Fuzz09_042_SWEHG {
    public static void test_lit_000() {
        int val = 0xABCD;
        print("0xABCD="); println(val);
        println("OK");
    }
    public static void test_lit_001() {
        long val = 1_000_000_000L;
        print("1_000_000_000L="); println(val);
        println("OK");
    }
    public static void test_lit_002() {
        int val = 0x0;
        print("0x0="); println(val);
        println("OK");
    }
    public static void test_lit_003() {
        int val = 0o77;
        print("0o77="); println(val);
        println("OK");
    }
    public static void test_lit_004() {
        float val = 3.14159f;
        print("3.14159f="); println(val);
        println("OK");
    }
    public static void test_lit_005() {
        int val = 0xFF;
        print("0xFF="); println(val);
        println("OK");
    }
    public static void test_lit_006() {
        float val = 3.14159f;
        print("3.14159f="); println(val);
        println("OK");
    }
    public static void test_lit_007() {
        int val = 0xABCD;
        print("0xABCD="); println(val);
        println("OK");
    }
    public static void test_lit_008() {
        int val = 0b11111111;
        print("0b11111111="); println(val);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_lit_000 START");
        test_lit_000();
        println("[SUB] test_lit_000 PASS");
        println("[SUB] test_lit_001 START");
        test_lit_001();
        println("[SUB] test_lit_001 PASS");
        println("[SUB] test_lit_002 START");
        test_lit_002();
        println("[SUB] test_lit_002 PASS");
        println("[SUB] test_lit_003 START");
        test_lit_003();
        println("[SUB] test_lit_003 PASS");
        println("[SUB] test_lit_004 START");
        test_lit_004();
        println("[SUB] test_lit_004 PASS");
        println("[SUB] test_lit_005 START");
        test_lit_005();
        println("[SUB] test_lit_005 PASS");
        println("[SUB] test_lit_006 START");
        test_lit_006();
        println("[SUB] test_lit_006 PASS");
        println("[SUB] test_lit_007 START");
        test_lit_007();
        println("[SUB] test_lit_007 PASS");
        println("[SUB] test_lit_008 START");
        test_lit_008();
        println("[SUB] test_lit_008 PASS");
    }
}
