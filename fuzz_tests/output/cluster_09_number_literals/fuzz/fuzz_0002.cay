// Fuzz Test: number_literals // Fuzz09_002_VNQJO
public class Fuzz09_002_VNQJO {
    public static void test_lit_000() {
        int val = 0x7FFFFFFF;
        print("0x7FFFFFFF="); println(val);
        println("OK");
    }
    public static void test_lit_001() {
        int val = 0o377;
        print("0o377="); println(val);
        println("OK");
    }
    public static void test_lit_002() {
        int val = 0b1;
        print("0b1="); println(val);
        println("OK");
    }
    public static void test_lit_003() {
        long val = 1_000_000_000L;
        print("1_000_000_000L="); println(val);
        println("OK");
    }
