// Fuzz Test: arrays_1d // Fuzz24_097_WWQQF
public class Fuzz24_097_WWQQF {
    public static void test_arr1_000() {
        int[] arr = new int[8];
        for(int i=0;i<8;i=i+1){arr[i]=i*3+5;}
        for(int i=0;i<arr.length;i=i+1){println(arr[i]);}
        int sum=0;
        for(int i=0;i<arr.length;i=i+1){sum=sum+arr[i];}
        print("sum="); println(sum);
        println("OK");
    }
