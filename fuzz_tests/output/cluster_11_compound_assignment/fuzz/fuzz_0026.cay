// Fuzz Test: compound_assignment // Fuzz11_026_PZDIR
public class Fuzz11_026_PZDIR {
    public static void test_ca_000() {
        int x = 49;
        x %= 4;
        print("49%=4="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 23;
        x /= 4;
        print("23/=4="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 42;
        x /= 4;
        print("42/=4="); println(x);
        println("OK");
    }
    public static void test_ca_003() {
        int x = 31;
        x *= 3;
        print("31*=3="); println(x);
        println("OK");
    }
    public static void test_ca_004() {
        int x = 36;
        x -= 10;
        print("36-=10="); println(x);
        println("OK");
    }
    public static void test_ca_005() {
