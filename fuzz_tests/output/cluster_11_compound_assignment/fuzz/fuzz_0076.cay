// Fuzz Test: compound_assignment // Fuzz11_076_ZUHEL
public class Fuzz11_076_ZUHEL {
    public static void test_ca_000() {
        int x = 53;
        x %= 6;
        print("53%=6="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 77;
        x += 8;
        print("77+=8="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 97;
        x %= 8;
        print("97%=8="); println(x);
        println("OK");
    }
