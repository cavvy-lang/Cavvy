// Fuzz Test: compound_assignment // Fuzz11_060_ETWCQ
public class Fuzz11_060_ETWCQ {
    public static void test_ca_000() {
        int x = 20;
        x /= 5;
        print("20/=5="); println(x);
        println("OK");
    }
