// Fuzz Test: compound_assignment // Fuzz11_036_SSUTD
public class Fuzz11_036_SSUTD {
    public static void test_ca_000() {
        int x = 23;
        x -= 6;
        print("23-=6="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 98;
        x %= 6;
        print("98%=6="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 27;
        x += 3;
        print("27+=3="); println(x);
        println("OK");
    }
    public static void test_ca_003() {
        int x = 17;
        x %= 2;
        print("17%=2="); println(x);
        println("OK");
    }
    public static void test_ca_004() {
        int x = 35;
        x /= 4;
        print("35/=4="); println(x);
        println("OK");
    }
    public static void test_ca_005() {
        int x = 89;
        x -= 4;
        print("89-=4="); println(x);
        println("OK");
    }
    public static void test_ca_006() {
