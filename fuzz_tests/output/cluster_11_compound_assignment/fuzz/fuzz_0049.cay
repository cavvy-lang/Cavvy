// Fuzz Test: compound_assignment // Fuzz11_049_KICAY
public class Fuzz11_049_KICAY {
    public static void test_ca_000() {
        int x = 61;
        x %= 8;
        print("61%=8="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 30;
        x += 1;
        print("30+=1="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 66;
        x %= 8;
        print("66%=8="); println(x);
        println("OK");
    }
    public static void test_ca_003() {
        int x = 3;
        x -= 8;
        print("3-=8="); println(x);
        println("OK");
    }
    public static void test_ca_004() {
        int x = 5;
        x /= 1;
        print("5/=1="); println(x);
        println("OK");
    }
