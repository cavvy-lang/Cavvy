// Fuzz Test: compound_assignment // Fuzz11_043_WMYBX
public class Fuzz11_043_WMYBX {
    public static void test_ca_000() {
        int x = 48;
        x %= 6;
        print("48%=6="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 57;
        x /= 3;
        print("57/=3="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 32;
        x %= 8;
        print("32%=8="); println(x);
        println("OK");
    }
    public static void test_ca_003() {
        int x = 73;
        x /= 5;
        print("73/=5="); println(x);
        println("OK");
    }
    public static void test_ca_004() {
