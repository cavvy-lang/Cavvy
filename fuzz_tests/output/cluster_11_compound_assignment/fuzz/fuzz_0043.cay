    }
    public static void test_ca_009() {
        int x = 2;
        x -= 4;
        print("2-=4="); println(x);
        println("OK");
    }
    public static void test_ca_010() {
        int x = 20;
        x += 1;
        print("20+=1="); println(x);
        println("OK");
    }
    public static void test_ca_011() {
        int x = 78;
        x += 3;
        print("78+=3="); println(x);
        println("OK");
    }
