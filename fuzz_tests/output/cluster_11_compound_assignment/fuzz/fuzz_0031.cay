// Fuzz Test: compound_assignment // Fuzz11_031_FPBWC
public class Fuzz11_031_FPBWC {
    public static void test_ca_000() {
        int x = 33;
        x -= 3;
        print("33-=3="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 89;
        x += 6;
        print("89+=6="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 33;
        x *= 5;
        print("33*=5="); println(x);
        println("OK");
    }
    public static void test_ca_003() {
        int x = 99;
        x += 1;
        print("99+=1="); println(x);
        println("OK");
    }
    public static void test_ca_004() {
        int x = 42;
        x -= 6;
        print("42-=6="); println(x);
        println("OK");
    }
    public static void test_ca_005() {
        int x = 63;
        x += 10;
        print("63+=10="); println(x);
        println("OK");
    }
    public static void test_ca_006() {
        int x = 93;
        x *= 7;
        print("93*=7="); println(x);
        println("OK");
    }
    public static void test_ca_007() {
        int x = 100;
        x %= 2;
        print("100%=2="); println(x);
        println("OK");
    }
    public static void test_ca_008() {
        int x = 85;
        x += 7;
        print("85+=7="); println(x);
        println("OK");
    }
    public static void test_ca_009() {
        int x = 72;
        x /= 9;
        print("72/=9="); println(x);
        println("OK");
    }
    public static void test_ca_010() {
        int x = 37;
        x %= 5;
        print("37%=5="); println(x);
        println("OK");
    }
    public static void test_ca_011() {
        int x = 35;
        x += 7;
        print("35+=7="); println(x);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_ca_000 START");
        test_ca_000();
        println("[SUB] test_ca_000 PASS");
        println("[SUB] test_ca_001 START");
