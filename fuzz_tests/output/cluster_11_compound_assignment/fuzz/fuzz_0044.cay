// Fuzz Test: compound_assignment // Fuzz11_044_TPPIC
public class Fuzz11_044_TPPIC {
    public static void test_ca_000() {
        int x = 29;
        x *= 7;
        print("29*=7="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 42;
        x %= 1;
        print("42%=1="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 92;
        x /= 6;
        print("92/=6="); println(x);
        println("OK");
    }
    public static void test_ca_003() {
