        println("OK");
    }
    public static void test_ca_011() {
        int x = 38;
        x %= 5;
        print("38%=5="); println(x);
        println("OK");
    }
    public static void test_ca_012() {
        int x = 68;
        x *= 1;
        print("68*=1="); println(x);
        println("OK");
    }
