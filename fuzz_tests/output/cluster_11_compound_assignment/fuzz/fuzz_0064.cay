// Fuzz Test: compound_assignment // Fuzz11_064_EDZRO
public class Fuzz11_064_EDZRO {
    public static void test_ca_000() {
        int x = 79;
        x %= 9;
        print("79%=9="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 28;
        x += 5;
        print("28+=5="); println(x);
        println("OK");
    }
