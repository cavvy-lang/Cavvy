// Fuzz Test: compound_assignment // Fuzz11_070_EZPCY
public class Fuzz11_070_EZPCY {
    public static void test_ca_000() {
        int x = 36;
        x %= 7;
        print("36%=7="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 71;
        x /= 1;
        print("71/=1="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 90;
        x += 4;
        print("90+=4="); println(x);
        println("OK");
    }
