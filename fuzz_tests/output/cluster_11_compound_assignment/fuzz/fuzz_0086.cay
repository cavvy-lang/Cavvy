// Fuzz Test: compound_assignment // Fuzz11_086_EUIEF
public class Fuzz11_086_EUIEF {
    public static void test_ca_000() {
        int x = 59;
        x /= 7;
        print("59/=7="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 58;
        x %= 8;
        print("58%=8="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 57;
        x -= 10;
        print("57-=10="); println(x);
        println("OK");
    }
    public static void test_ca_003() {
        int x = 19;
        x *= 3;
        print("19*=3="); println(x);
        println("OK");
    }
    public static void test_ca_004() {
