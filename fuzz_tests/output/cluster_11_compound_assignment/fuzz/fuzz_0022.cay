        print("5/=2="); println(x);
        println("OK");
    }
    public static void test_ca_010() {
        int x = 17;
        x %= 8;
        print("17%=8="); println(x);
        println("OK");
    }
    public static void test_ca_011() {
        int x = 88;
        x /= 8;
        print("88/=8="); println(x);
        println("OK");
    }
    public static void test_ca_012() {
        int x = 100;
        x *= 6;
        print("100*=6="); println(x);
        println("OK");
    }
    public static void test_ca_013() {
        int x = 10;
        x %= 8;
        print("10%=8="); println(x);
        println("OK");
    }
