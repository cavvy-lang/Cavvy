// Fuzz Test: compound_assignment // Fuzz11_022_RVLWT
public class Fuzz11_022_RVLWT {
    public static void test_ca_000() {
        int x = 45;
        x += 2;
        print("45+=2="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 5;
        x /= 7;
        print("5/=7="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 83;
        x += 10;
        print("83+=10="); println(x);
        println("OK");
    }
    public static void test_ca_003() {
        int x = 18;
        x /= 9;
        print("18/=9="); println(x);
        println("OK");
    }
    public static void test_ca_004() {
        int x = 34;
