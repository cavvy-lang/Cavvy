// Fuzz Test: compound_assignment // Fuzz11_033_XWTOZ
public class Fuzz11_033_XWTOZ {
    public static void test_ca_000() {
        int x = 59;
        x += 1;
        print("59+=1="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 17;
        x /= 1;
        print("17/=1="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 99;
        x %= 7;
        print("99%=7="); println(x);
        println("OK");
    }
    public static void test_ca_003() {
        int x = 75;
        x /= 8;
        print("75/=8="); println(x);
        println("OK");
    }
    public static void test_ca_004() {
        int x = 34;
        x %= 9;
        print("34%=9="); println(x);
        println("OK");
    }
    public static void test_ca_005() {
        int x = 89;
        x /= 5;
        print("89/=5="); println(x);
        println("OK");
    }
    public static void test_ca_006() {
        int x = 33;
        x *= 7;
        print("33*=7="); println(x);
        println("OK");
    }
    public static void test_ca_007() {
        int x = 8;
        x *= 1;
        print("8*=1="); println(x);
        println("OK");
    }
    public static void test_ca_008() {
        int x = 26;
        x /= 10;
        print("26/=10="); println(x);
        println("OK");
    }
    public static void test_ca_009() {
        int x = 90;
        x %= 8;
        print("90%=8="); println(x);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_ca_000 START");
        test_ca_000();
        println("[SUB] test_ca_000 PASS");
        println("[SUB] test_ca_001 START");
        test_ca_001();
        println("[SUB] test_ca_001 PASS");
        println("[SUB] test_ca_002 START");
        test_ca_002();
        println("[SUB] test_ca_002 PASS");
        println("[SUB] test_ca_003 START");
        test_ca_003();
        println("[SUB] test_ca_003 PASS");
        println("[SUB] test_ca_004 START");
        test_ca_004();
        println("[SUB] test_ca_004 PASS");
        println("[SUB] test_ca_005 START");
        test_ca_005();
        println("[SUB] test_ca_005 PASS");
        println("[SUB] test_ca_006 START");
        test_ca_006();
        println("[SUB] test_ca_006 PASS");
        println("[SUB] test_ca_007 START");
        test_ca_007();
        println("[SUB] test_ca_007 PASS");
        println("[SUB] test_ca_008 START");
        test_ca_008();
        println("[SUB] test_ca_008 PASS");
        println("[SUB] test_ca_009 START");
        test_ca_009();
        println("[SUB] test_ca_009 PASS");
    }
}
