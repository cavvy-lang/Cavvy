        println("OK");
    }
    public static void test_ca_011() {
        int x = 46;
        x /= 10;
        print("46/=10="); println(x);
        println("OK");
    }
    public static void test_ca_012() {
        int x = 5;
        x %= 9;
        print("5%=9="); println(x);
        println("OK");
    }
