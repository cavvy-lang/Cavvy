// Fuzz Test: compound_assignment // Fuzz11_015_SBWVR
public class Fuzz11_015_SBWVR {
    public static void test_ca_000() {
        int x = 19;
        x += 1;
        print("19+=1="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 16;
        x /= 7;
        print("16/=7="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 26;
        x /= 1;
        print("26/=1="); println(x);
        println("OK");
    }
    public static void test_ca_003() {
        int x = 23;
        x %= 7;
        print("23%=7="); println(x);
        println("OK");
    }
    public static void test_ca_004() {
        int x = 23;
        x -= 9;
        print("23-=9="); println(x);
        println("OK");
    }
    public static void test_ca_005() {
        int x = 17;
        x -= 6;
        print("17-=6="); println(x);
        println("OK");
    }
