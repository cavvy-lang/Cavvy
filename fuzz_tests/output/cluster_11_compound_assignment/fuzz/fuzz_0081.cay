// Fuzz Test: compound_assignment // Fuzz11_081_NITVO
public class Fuzz11_081_NITVO {
    public static void test_ca_000() {
        int x = 47;
        x -= 9;
        print("47-=9="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 49;
        x /= 9;
        print("49/=9="); println(x);
        println("OK");
    }
