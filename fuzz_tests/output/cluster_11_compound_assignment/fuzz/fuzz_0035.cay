// Fuzz Test: compound_assignment // Fuzz11_035_ZRDHL
public class Fuzz11_035_ZRDHL {
    public static void test_ca_000() {
        int x = 4;
        x -= 8;
        print("4-=8="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 80;
        x *= 10;
        print("80*=10="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 25;
        x *= 9;
        print("25*=9="); println(x);
        println("OK");
    }
