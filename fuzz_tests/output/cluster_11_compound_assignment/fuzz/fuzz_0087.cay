// Fuzz Test: compound_assignment // Fuzz11_087_RMCSE
public class Fuzz11_087_RMCSE {
    public static void test_ca_000() {
        int x = 18;
        x -= 2;
        print("18-=2="); println(x);
        println("OK");
    }
    public static void test_ca_001() {
        int x = 93;
        x += 2;
        print("93+=2="); println(x);
        println("OK");
    }
    public static void test_ca_002() {
        int x = 12;
        x -= 3;
        print("12-=3="); println(x);
        println("OK");
    }
    public static void test_ca_003() {
        int x = 83;
        x += 3;
        print("83+=3="); println(x);
        println("OK");
    }
