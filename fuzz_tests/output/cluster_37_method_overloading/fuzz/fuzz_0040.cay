// Fuzz Test: method_overloading // Fuzz37_040_KJJAW
public class Fuzz37_040_KJJAW {
    public static void test_ol_000() {
        int a=98; int b=67;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
