// Fuzz Test: method_overloading // Fuzz37_059_JIRYT
public class Fuzz37_059_JIRYT {
    public static void test_ol_000() {
        int a=35; int b=89;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
