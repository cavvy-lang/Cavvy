// Fuzz Test: method_overloading // Fuzz37_090_UBRGO
public class Fuzz37_090_UBRGO {
    public static void test_ol_000() {
        int a=31; int b=26;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_001() {
        int a=11; int b=89;
        int c = a + b;
        print("overload="); println(c);
