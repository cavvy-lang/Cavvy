// Fuzz Test: method_overloading // Fuzz37_082_FLVZM
public class Fuzz37_082_FLVZM {
    public static void test_ol_000() {
        int a=40; int b=16;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
