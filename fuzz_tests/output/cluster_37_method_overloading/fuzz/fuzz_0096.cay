// Fuzz Test: method_overloading // Fuzz37_096_NLDXE
public class Fuzz37_096_NLDXE {
    public static void test_ol_000() {
        int a=72; int b=30;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
