// Fuzz Test: method_overloading // Fuzz37_069_FOCZI
public class Fuzz37_069_FOCZI {
    public static void test_ol_000() {
        int a=100; int b=19;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
