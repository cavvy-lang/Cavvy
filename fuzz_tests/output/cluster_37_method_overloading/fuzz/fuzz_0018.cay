// Fuzz Test: method_overloading // Fuzz37_018_LSBQL
public class Fuzz37_018_LSBQL {
    public static void test_ol_000() {
        int a=30; int b=62;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_001() {
        int a=23; int b=96;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
