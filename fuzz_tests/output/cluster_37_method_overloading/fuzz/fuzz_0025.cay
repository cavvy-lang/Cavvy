// Fuzz Test: method_overloading // Fuzz37_025_TUJMR
public class Fuzz37_025_TUJMR {
    public static void test_ol_000() {
        int a=27; int b=78;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
