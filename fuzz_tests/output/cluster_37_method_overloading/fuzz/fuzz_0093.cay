// Fuzz Test: method_overloading // Fuzz37_093_KSUWE
public class Fuzz37_093_KSUWE {
    public static void test_ol_000() {
        int a=79; int b=84;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_001() {
        int a=27; int b=46;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
