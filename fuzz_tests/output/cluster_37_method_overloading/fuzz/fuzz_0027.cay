// Fuzz Test: method_overloading // Fuzz37_027_SRGLC
public class Fuzz37_027_SRGLC {
    public static void test_ol_000() {
        int a=79; int b=56;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_001() {
        int a=35; int b=79;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
