// Fuzz Test: method_overloading // Fuzz37_038_UWLWQ
public class Fuzz37_038_UWLWQ {
    public static void test_ol_000() {
        int a=60; int b=15;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
