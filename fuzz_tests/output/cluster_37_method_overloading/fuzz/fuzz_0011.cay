// Fuzz Test: method_overloading // Fuzz37_011_LGWVE
public class Fuzz37_011_LGWVE {
    public static void test_ol_000() {
        int a=27; int b=2;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
