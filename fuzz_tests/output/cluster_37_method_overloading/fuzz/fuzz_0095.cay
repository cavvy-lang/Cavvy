// Fuzz Test: method_overloading // Fuzz37_095_JGMLS
public class Fuzz37_095_JGMLS {
    public static void test_ol_000() {
        int a=34; int b=61;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_001() {
        int a=2; int b=33;
        int c = a + b;
        print("overload="); println(c);
