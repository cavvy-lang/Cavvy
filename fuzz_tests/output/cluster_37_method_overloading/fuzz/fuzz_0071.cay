// Fuzz Test: method_overloading // Fuzz37_071_OYHDT
public class Fuzz37_071_OYHDT {
    public static void test_ol_000() {
        int a=38; int b=43;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
