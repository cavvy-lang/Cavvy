// Fuzz Test: method_overloading // Fuzz37_056_EBRJJ
public class Fuzz37_056_EBRJJ {
    public static void test_ol_000() {
        int a=66; int b=22;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
