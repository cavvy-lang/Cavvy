// Fuzz Test: method_overloading // Fuzz37_074_EPZHN
public class Fuzz37_074_EPZHN {
    public static void test_ol_000() {
        int a=2; int b=29;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
