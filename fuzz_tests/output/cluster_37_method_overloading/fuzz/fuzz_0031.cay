// Fuzz Test: method_overloading // Fuzz37_031_OGRAL
public class Fuzz37_031_OGRAL {
    public static void test_ol_000() {
        int a=44; int b=77;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_001() {
        int a=15; int b=45;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
