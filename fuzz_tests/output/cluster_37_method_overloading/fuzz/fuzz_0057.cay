// Fuzz Test: method_overloading // Fuzz37_057_WSAJH
public class Fuzz37_057_WSAJH {
    public static void test_ol_000() {
        int a=15; int b=43;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_001() {
        int a=20; int b=94;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
