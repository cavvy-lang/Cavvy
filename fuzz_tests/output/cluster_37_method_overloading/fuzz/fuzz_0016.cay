// Fuzz Test: method_overloading // Fuzz37_016_OWSYZ
public class Fuzz37_016_OWSYZ {
    public static void test_ol_000() {
        int a=62; int b=47;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
