// Fuzz Test: method_overloading // Fuzz37_084_PHPXA
public class Fuzz37_084_PHPXA {
    public static void test_ol_000() {
        int a=20; int b=55;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
