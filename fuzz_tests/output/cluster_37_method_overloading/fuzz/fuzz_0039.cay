// Fuzz Test: method_overloading // Fuzz37_039_MJPPN
public class Fuzz37_039_MJPPN {
    public static void test_ol_000() {
        int a=76; int b=28;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
