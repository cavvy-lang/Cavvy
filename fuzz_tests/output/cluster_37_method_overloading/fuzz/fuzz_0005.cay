// Fuzz Test: method_overloading // Fuzz37_005_JNTUD
public class Fuzz37_005_JNTUD {
    public static void test_ol_000() {
        int a=5; int b=99;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_001() {
        int a=86; int b=31;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_002() {
