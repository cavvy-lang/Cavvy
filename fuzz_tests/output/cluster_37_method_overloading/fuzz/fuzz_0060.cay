// Fuzz Test: method_overloading // Fuzz37_060_ZVJAL
public class Fuzz37_060_ZVJAL {
    public static void test_ol_000() {
        int a=91; int b=89;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
