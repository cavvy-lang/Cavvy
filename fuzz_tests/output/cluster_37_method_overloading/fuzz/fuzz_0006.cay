// Fuzz Test: method_overloading // Fuzz37_006_XQVQA
public class Fuzz37_006_XQVQA {
    public static void test_ol_000() {
        int a=50; int b=44;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
