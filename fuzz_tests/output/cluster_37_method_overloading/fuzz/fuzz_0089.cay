// Fuzz Test: method_overloading // Fuzz37_089_GOLWC
public class Fuzz37_089_GOLWC {
    public static void test_ol_000() {
        int a=7; int b=75;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_001() {
        int a=3; int b=35;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_002() {
        int a=70; int b=9;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_003() {
