// Fuzz Test: method_overloading // Fuzz37_014_PMNRS
public class Fuzz37_014_PMNRS {
    public static void test_ol_000() {
        int a=86; int b=100;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_001() {
        int a=10; int b=24;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_002() {
        int a=26; int b=26;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
