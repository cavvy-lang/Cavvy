// Fuzz Test: method_overloading // Fuzz37_083_IUERW
public class Fuzz37_083_IUERW {
    public static void test_ol_000() {
        int a=69; int b=93;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
