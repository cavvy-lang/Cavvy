        print("overload="); println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_ol_000 START");
        test_ol_000();
        println("[SUB] test_ol_000 PASS");
        println("[SUB] test_ol_001 START");
        test_ol_001();
        println("[SUB] test_ol_001 PASS");
        println("[SUB] test_ol_002 START");
