// Fuzz Test: method_overloading // Fuzz37_021_FTYCQ
public class Fuzz37_021_FTYCQ {
    public static void test_ol_000() {
        int a=9; int b=50;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_001() {
        int a=88; int b=25;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_002() {
        int a=30; int b=62;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_003() {
