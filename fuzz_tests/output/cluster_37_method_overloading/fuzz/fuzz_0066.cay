// Fuzz Test: method_overloading // Fuzz37_066_UDTST
public class Fuzz37_066_UDTST {
    public static void test_ol_000() {
        int a=7; int b=59;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_001() {
        int a=44; int b=21;
        int c = a + b;
        print("overload="); println(c);
        println("OK");
    }
    public static void test_ol_002() {
