// Fuzz Test: string_basics // Fuzz05_024_AHSDK
public class Fuzz05_024_AHSDK {
    public static void test_str_000() {
        String s1 = "true";
        String s2 = "zyxwvutsrqponmlkjihgfedcba";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_001() {
        String s = "world";
        print("len=");
        println(s.length());
        println("OK");
    }
