// Fuzz Test: string_basics // Fuzz05_077_DBCVI
public class Fuzz05_077_DBCVI {
    public static void test_str_000() {
        String s = "0xDEADBEEF";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_001() {
        String s1 = "lowercase";
        String s2 = "!@#$%^&*()";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_002() {
        String s = "true";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_003() {
        String s1 = "jumps over";
        String s2 = "0xDEADBEEF";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_004() {
        String s1 = "abc";
        String s2 = "true";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_005() {
        String s = "  spaces  ";
        print("len=");
        println(s.length());
        println("OK");
    }
