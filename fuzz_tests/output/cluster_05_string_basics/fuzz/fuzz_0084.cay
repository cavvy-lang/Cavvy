        println("OK");
    }
    public static void test_str_003() {
        String s = "UPPERCASE";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_004() {
        String s1 = "中文测试";
        String s2 = "CamelCaseStyle";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_005() {
        String s = "world";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_006() {
        String s1 = "a";
        String s2 = "hello";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_007() {
        String s = "newline\nhere";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_008() {
        String s = "";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_009() {
        String s = "!@#$%^&*()";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_010() {
        String s = "hello";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_str_000 START");
