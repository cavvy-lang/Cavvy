// Fuzz Test: string_basics // Fuzz05_084_NMWKF
public class Fuzz05_084_NMWKF {
    public static void test_str_000() {
        String s = "kebab-case-style";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_001() {
        String s = "Cavvy";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_002() {
        String s = "kebab-case-style";
        print("len=");
