        println(s3);
        println("OK");
    }
    public static void test_str_011() {
        String s1 = "The quick brown fox";
        String s2 = "UPPERCASE";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_012() {
        String s1 = "hello";
        String s2 = "  spaces  ";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_013() {
        String s = "null";
        print("len=");
        println(s.length());
        println("OK");
    }
