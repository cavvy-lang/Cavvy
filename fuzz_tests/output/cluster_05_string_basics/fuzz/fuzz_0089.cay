// Fuzz Test: string_basics // Fuzz05_089_IDHRS
public class Fuzz05_089_IDHRS {
    public static void test_str_000() {
        String s = "true";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_001() {
        String s1 = "12345";
        String s2 = "null";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_002() {
        String s = "CamelCaseStyle";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_003() {
        String s1 = "jumps over";
        String s2 = "snake_case_style";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
