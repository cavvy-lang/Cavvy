// Fuzz Test: string_basics // Fuzz05_040_MMHBM
public class Fuzz05_040_MMHBM {
    public static void test_str_000() {
        String s = "hello";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_001() {
        String s1 = "newline\nhere";
        String s2 = "null";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_002() {
        String s1 = "zyxwvutsrqponmlkjihgfedcba";
        String s2 = "中文测试";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_003() {
        String s1 = "hello";
        String s2 = "!@#$%^&*()";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_004() {
        String s = "12345";
        print("len=");
        println(s.length());
        println("OK");
    }
