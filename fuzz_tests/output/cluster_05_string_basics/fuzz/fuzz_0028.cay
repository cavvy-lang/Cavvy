// Fuzz Test: string_basics // Fuzz05_028_CQRVC
public class Fuzz05_028_CQRVC {
    public static void test_str_000() {
        String s1 = "String with \'quotes\' inside";
        String s2 = "Cavvy";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_001() {
        String s = "中文测试";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_002() {
