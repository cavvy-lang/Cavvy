    public static void test_str_011() {
        String s1 = "jumps over";
        String s2 = "false";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_012() {
        String s = "hello";
        print("len=");
        println(s.length());
        println("OK");
    }
