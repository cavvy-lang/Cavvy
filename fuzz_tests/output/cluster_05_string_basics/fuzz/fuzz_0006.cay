// Fuzz Test: string_basics // Fuzz05_006_BVOSI
public class Fuzz05_006_BVOSI {
    public static void test_str_000() {
        String s1 = "abcdef";
        String s2 = "  spaces  ";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_001() {
        String s1 = "Cavvy";
        String s2 = "";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_002() {
        String s = "zyxwvutsrqponmlkjihgfedcba";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_003() {
        String s = "   ";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_004() {
        String s1 = "jumps over";
        String s2 = "the lazy dog";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_005() {
