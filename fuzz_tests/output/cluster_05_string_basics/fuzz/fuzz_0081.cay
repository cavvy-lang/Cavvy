    public static void test_str_000() {
        String s = "lowercase";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_001() {
        String s = "abcdef";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_002() {
        String s1 = "0xDEADBEEF";
        String s2 = "The quick brown fox";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_003() {
        String s1 = "the lazy dog";
        String s2 = "a";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_004() {
        String s = "!@#$%^&*()";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_005() {
        String s = "The quick brown fox";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_006() {
        String s1 = "3.141592653589793";
        String s2 = "hello";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_007() {
        String s = "zyxwvutsrqponmlkjihgfedcba";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void run_all() {
