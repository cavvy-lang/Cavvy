    public static void test_str_000() {
        String s = "MixedCase123";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_001() {
        String s = "the lazy dog";
        print("len=");
        println(s.length());
        println("OK");
    }
