// Fuzz Test: string_basics // Fuzz05_027_TSGHT
public class Fuzz05_027_TSGHT {
    public static void test_str_000() {
        String s1 = "hello";
        String s2 = "Cavvy";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_001() {
        String s = "jumps over";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_002() {
        String s = "abc";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_003() {
        String s = "3.141592653589793";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_004() {
        String s1 = "3.141592653589793";
        String s2 = "3.141592653589793";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_005() {
        String s1 = "The quick brown fox";
        String s2 = "CamelCaseStyle";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_006() {
        String s1 = "the lazy dog";
        String s2 = "Cavvy";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_007() {
        String s = "snake_case_style";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_008() {
        String s = "the lazy dog";
        print("len=");
