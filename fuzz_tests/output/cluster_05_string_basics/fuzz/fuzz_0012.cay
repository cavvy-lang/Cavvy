// Fuzz Test: string_basics // Fuzz05_012_JZPQX
public class Fuzz05_012_JZPQX {
    public static void test_str_000() {
        String s = "";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_001() {
        String s = "12345";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_002() {
        String s1 = "Cavvy";
        String s2 = "null";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_003() {
        String s1 = "MixedCase123";
        String s2 = "jumps over";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_004() {
        String s = "中文测试";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_005() {
        String s1 = "a";
        String s2 = "String with \'quotes\' inside";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_006() {
        String s1 = "CamelCaseStyle";
        String s2 = "MixedCase123";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_007() {
        String s1 = "abcdef";
        String s2 = "true";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_008() {
        String s1 = "abc";
        String s2 = "3.141592653589793";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_str_000 START");
        test_str_000();
        println("[SUB] test_str_000 PASS");
        println("[SUB] test_str_001 START");
