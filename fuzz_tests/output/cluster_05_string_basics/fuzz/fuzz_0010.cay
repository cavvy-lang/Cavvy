    public static void test_str_009() {
        String s1 = "CamelCaseStyle";
        String s2 = "jumps over";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_010() {
        String s = "null";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_011() {
        String s = "snake_case_style";
        print("len=");
        println(s.length());
        println("OK");
    }
