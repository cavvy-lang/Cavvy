// Fuzz Test: string_basics // Fuzz05_010_STGPH
public class Fuzz05_010_STGPH {
    public static void test_str_000() {
        String s1 = "12345";
        String s2 = "12345";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_001() {
        String s = "abc";
        print("len=");
        println(s.length());
        println("OK");
    }
    public static void test_str_002() {
        String s1 = "newline\nhere";
        String s2 = "UPPERCASE";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_003() {
        String s1 = "the lazy dog";
        String s2 = "true";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
    public static void test_str_004() {
        String s1 = "jumps over";
        String s2 = "hello";
        String s3 = s1 + s2;
        println(s3);
        println("OK");
    }
