// Fuzz Test: string_methods // Fuzz06_022_TFJPF
public class Fuzz06_022_TFJPF {
    public static void test_strm_000() {
        String s="xyx";
        int cp=s.compareTo("abc");
        println(cp);
        println("OK");
    }
    public static void test_strm_001() {
        String s="bb";
        boolean en=s.endsWith("z");
        println(en);
        println("OK");
    }
    public static void test_strm_002() {
        String s="abcd";
        boolean eq=s.equals("hello");
        println(eq);
        println("OK");
    }
    public static void test_strm_003() {
        String s="world";
        String t=s.trim();
        println(t);
        println("OK");
    }
    public static void test_strm_004() {
        String s="Hello";
        print("len="); println(s.length());
        println("OK");
    }
    public static void test_strm_005() {
        String s="A";
        int cp=s.compareTo("abc");
        println(cp);
        println("OK");
    }
    public static void test_strm_006() {
        String s="xyx";
        int idx=s.indexOf("a");
        println(idx);
        println("OK");
    }
    public static void test_strm_007() {
        String s="bb";
        String t=s.trim();
        println(t);
        println("OK");
    }
    public static void test_strm_008() {
        String s="TestString";
        String r=s.replace("a","X");
        println(r);
        println("OK");
    }
    public static void test_strm_009() {
        String s="world";
        boolean em=s.isEmpty();
        println(em);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_strm_000 START");
        test_strm_000();
        println("[SUB] test_strm_000 PASS");
        println("[SUB] test_strm_001 START");
        test_strm_001();
        println("[SUB] test_strm_001 PASS");
        println("[SUB] test_strm_002 START");
        test_strm_002();
        println("[SUB] test_strm_002 PASS");
        println("[SUB] test_strm_003 START");
        test_strm_003();
        println("[SUB] test_strm_003 PASS");
        println("[SUB] test_strm_004 START");
        test_strm_004();
        println("[SUB] test_strm_004 PASS");
        println("[SUB] test_strm_005 START");
        test_strm_005();
        println("[SUB] test_strm_005 PASS");
        println("[SUB] test_strm_006 START");
        test_strm_006();
        println("[SUB] test_strm_006 PASS");
        println("[SUB] test_strm_007 START");
        test_strm_007();
        println("[SUB] test_strm_007 PASS");
        println("[SUB] test_strm_008 START");
        test_strm_008();
        println("[SUB] test_strm_008 PASS");
        println("[SUB] test_strm_009 START");
        test_strm_009();
        println("[SUB] test_strm_009 PASS");
    }
}
