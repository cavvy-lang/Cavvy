// Fuzz Test: string_methods // Fuzz06_004_IXKWU
public class Fuzz06_004_IXKWU {
    public static void test_strm_000() {
        String s="";
        boolean em=s.isEmpty();
        println(em);
        println("OK");
    }
    public static void test_strm_001() {
        String s="bb";
        String sub=s.substring(0,1);
        println(sub);
        println("OK");
    }
    public static void test_strm_002() {
        String s="bb";
        String t=s.trim();
        println(t);
        println("OK");
    }
    public static void test_strm_003() {
        String s="world";
        boolean em=s.isEmpty();
        println(em);
        println("OK");
    }
    public static void test_strm_004() {
        String s="TestString";
        String r=s.replace("a","X");
        println(r);
        println("OK");
    }
    public static void test_strm_005() {
        String s="Hello";
        int cp=s.compareTo("abc");
        println(cp);
        println("OK");
    }
    public static void test_strm_006() {
        String s="abc";
        int idx=s.indexOf("a");
        println(idx);
        println("OK");
    }
    public static void test_strm_007() {
        String s="Hello";
        int cp=s.compareTo("abc");
        println(cp);
        println("OK");
    }
    public static void test_strm_008() {
        String s="TestString";
        boolean en=s.endsWith("z");
        println(en);
        println("OK");
    }
    public static void test_strm_009() {
        String s="  hi  ";
        boolean en=s.endsWith("z");
        println(en);
        println("OK");
    }
    public static void test_strm_010() {
        String s="abc";
        char c=s.charAt(0);
        println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_strm_000 START");
