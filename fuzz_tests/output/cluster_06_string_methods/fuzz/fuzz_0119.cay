// Fuzz Test: string_methods // Fuzz06_119_DZDFZ
public class Fuzz06_119_DZDFZ {
    public static void test_strm_000() {
        String s="world";
        String r=s.replace("a","X");
        println(r);
        println("OK");
    }
    public static void test_strm_001() {
        String s="Cavvy";
        String u=s.toLowerCase();
        println(u);
        println("OK");
    }
    public static void test_strm_002() {
        String s="hello";
        int cp=s.compareTo("abc");
        println(cp);
        println("OK");
    }
    public static void test_strm_003() {
        String s="A";
        int cp=s.compareTo("abc");
        println(cp);
        println("OK");
    }
    public static void test_strm_004() {
        String s="Cavvy";
        boolean en=s.endsWith("z");
        println(en);
        println("OK");
    }
    public static void test_strm_005() {
        String s="xyx";
        String sub=s.substring(0,1);
        println(sub);
        println("OK");
    }
