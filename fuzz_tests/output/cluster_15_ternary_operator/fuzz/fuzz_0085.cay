// Fuzz Test: ternary_operator // Fuzz15_085_ABVRE
public class Fuzz15_085_ABVRE {
    public static void test_tern_000() {
        int a = 96; int b = -89;
        int r = (96==0) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_001() {
        int a = 55; int b = 80;
        int r = (55!=80) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_002() {
        int a = 0; int b = 60;
        int r = (0>=60) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_003() {
        int a = 65; int b = 84;
        int r = (65==0) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_004() {
        int a = 45; int b = 18;
        int r = (45==0) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_005() {
        int a = -96; int b = 65;
        int r = (-96>0) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_006() {
        int a = -13; int b = 80;
        int r = (-13>0) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_007() {
        int a = 56; int b = 47;
        int r = (56>0) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_008() {
        int a = -82; int b = 43;
        int r = (-82<=0) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_009() {
        int a = -3; int b = -90;
        int r = (-3>=-90) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_010() {
        int a = -11; int b = 2;
        int r = (-11>=2) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_011() {
        int a = 87; int b = -30;
        int r = (87<=0) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_tern_000 START");
        test_tern_000();
        println("[SUB] test_tern_000 PASS");
        println("[SUB] test_tern_001 START");
        test_tern_001();
        println("[SUB] test_tern_001 PASS");
        println("[SUB] test_tern_002 START");
        test_tern_002();
        println("[SUB] test_tern_002 PASS");
        println("[SUB] test_tern_003 START");
        test_tern_003();
        println("[SUB] test_tern_003 PASS");
        println("[SUB] test_tern_004 START");
        test_tern_004();
        println("[SUB] test_tern_004 PASS");
        println("[SUB] test_tern_005 START");
        test_tern_005();
        println("[SUB] test_tern_005 PASS");
        println("[SUB] test_tern_006 START");
        test_tern_006();
        println("[SUB] test_tern_006 PASS");
        println("[SUB] test_tern_007 START");
        test_tern_007();
        println("[SUB] test_tern_007 PASS");
        println("[SUB] test_tern_008 START");
        test_tern_008();
        println("[SUB] test_tern_008 PASS");
        println("[SUB] test_tern_009 START");
        test_tern_009();
        println("[SUB] test_tern_009 PASS");
        println("[SUB] test_tern_010 START");
        test_tern_010();
        println("[SUB] test_tern_010 PASS");
        println("[SUB] test_tern_011 START");
        test_tern_011();
        println("[SUB] test_tern_011 PASS");
    }
}
