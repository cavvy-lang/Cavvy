// Fuzz Test: ternary_operator // Fuzz15_071_QMLCE
public class Fuzz15_071_QMLCE {
    public static void test_tern_000() {
        int a = -61; int b = -90;
        int r = (-61<=0) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_001() {
        int a = -1; int b = -65;
        int r = (-1==0) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_002() {
        int a = 4; int b = -82;
        int r = (4<=0) ? a : b;
        print("tern="); println(r);
        println("OK");
    }
    public static void test_tern_003() {
