// Fuzz Test: array_edge // Fuzz28_022_BIJLV
public class Fuzz28_022_BIJLV {
    public static void test_aedge_000() {
        int[] arr = new int[1];
        print("len="); println(arr.length);
        for(int i=0;i<arr.length;i=i+1){arr[i]=i*7;}
        print("first="); println(arr[0]);
        print("last="); println(arr[arr.length-1]);
        int[] arr2 = new int[0];
        print("zero_len="); println(arr2.length);
        println("OK");
    }
