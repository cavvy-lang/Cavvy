        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_011() {
        int a = 63095; int b = 5; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_012() {
        int a = 8712; int b = 7; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_bit_000 START");
