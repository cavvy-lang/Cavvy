// Fuzz Test: bitwise_operators // Fuzz14_005_TPJFW
public class Fuzz14_005_TPJFW {
    public static void test_bit_000() {
        int a = 21907; int b = 14; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_001() {
        int a = 12015; int b = 2; int c = a >> b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_002() {
        int a = 59720; int b = 8; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
