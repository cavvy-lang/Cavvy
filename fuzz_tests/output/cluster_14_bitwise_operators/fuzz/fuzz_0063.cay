// Fuzz Test: bitwise_operators // Fuzz14_063_KXJLC
public class Fuzz14_063_KXJLC {
    public static void test_bit_000() {
        int a = 22648; int b = 10; int c = a & b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_001() {
        int a = 23032; int b = 4; int c = a >> b;
        print("bit="); println(c);
        println("OK");
    }
