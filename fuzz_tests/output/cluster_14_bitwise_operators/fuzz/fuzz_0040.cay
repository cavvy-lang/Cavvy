// Fuzz Test: bitwise_operators // Fuzz14_040_MMYMD
public class Fuzz14_040_MMYMD {
    public static void test_bit_000() {
        int a = 10805; int b = 1; int c = a & b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_001() {
        int a = 1698; int b = 4; int c = a & b;
        print("bit="); println(c);
        println("OK");
    }
