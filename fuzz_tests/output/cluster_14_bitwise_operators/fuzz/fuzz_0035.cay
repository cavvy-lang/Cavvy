// Fuzz Test: bitwise_operators // Fuzz14_035_QLMLD
public class Fuzz14_035_QLMLD {
    public static void test_bit_000() {
        int a = 56519; int b = 1; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_001() {
        int a = 43565; int b = 6; int c = a & b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_002() {
        int a = 38363; int b = 2; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_003() {
        int a = 19238; int b = 3; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
