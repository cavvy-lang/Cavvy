// Fuzz Test: bitwise_operators // Fuzz14_075_DCWLK
public class Fuzz14_075_DCWLK {
    public static void test_bit_000() {
        int a = 28940; int b = 5; int c = a >> b;
        print("bit="); println(c);
        println("OK");
    }
