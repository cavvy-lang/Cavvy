// Fuzz Test: bitwise_operators // Fuzz14_042_PXGQN
public class Fuzz14_042_PXGQN {
    public static void test_bit_000() {
        int a = 19034; int b = 12; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_001() {
        int a = 61597; int b = 5; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_002() {
        int a = 56473; int b = 8; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_003() {
        int a = 29675; int b = 12; int c = a & b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_004() {
        int a = 7653; int b = 0; int c = a >> b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_005() {
        int a = 54694; int b = 7; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_006() {
