// Fuzz Test: bitwise_operators // Fuzz14_015_OICOO
public class Fuzz14_015_OICOO {
    public static void test_bit_000() {
        int a = 4089; int b = 2; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_001() {
        int a = 1379; int b = 14; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_002() {
        int a = 44887; int b = 2; int c = a ^ b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_003() {
        int a = 58024; int b = 4; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_004() {
        int a = 16997; int b = 8; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_005() {
        int a = 42347; int b = 8; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_006() {
        int a = 32395; int b = 5; int c = a & b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_007() {
        int a = 42309; int b = 4; int c = a >> b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_008() {
        int a = 23316; int b = 11; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_009() {
        int a = 43602; int b = 5; int c = a >> b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_010() {
        int a = 44734; int b = 1; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_bit_000 START");
        test_bit_000();
        println("[SUB] test_bit_000 PASS");
        println("[SUB] test_bit_001 START");
        test_bit_001();
        println("[SUB] test_bit_001 PASS");
        println("[SUB] test_bit_002 START");
        test_bit_002();
        println("[SUB] test_bit_002 PASS");
        println("[SUB] test_bit_003 START");
        test_bit_003();
        println("[SUB] test_bit_003 PASS");
        println("[SUB] test_bit_004 START");
        test_bit_004();
        println("[SUB] test_bit_004 PASS");
        println("[SUB] test_bit_005 START");
        test_bit_005();
        println("[SUB] test_bit_005 PASS");
        println("[SUB] test_bit_006 START");
        test_bit_006();
        println("[SUB] test_bit_006 PASS");
        println("[SUB] test_bit_007 START");
        test_bit_007();
        println("[SUB] test_bit_007 PASS");
        println("[SUB] test_bit_008 START");
        test_bit_008();
        println("[SUB] test_bit_008 PASS");
        println("[SUB] test_bit_009 START");
        test_bit_009();
        println("[SUB] test_bit_009 PASS");
        println("[SUB] test_bit_010 START");
        test_bit_010();
        println("[SUB] test_bit_010 PASS");
    }
}
