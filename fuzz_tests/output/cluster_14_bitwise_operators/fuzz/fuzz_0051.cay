// Fuzz Test: bitwise_operators // Fuzz14_051_TPFKJ
public class Fuzz14_051_TPFKJ {
    public static void test_bit_000() {
        int a = 37750; int b = 0; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_001() {
        int a = 42057; int b = 14; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
