// Fuzz Test: bitwise_operators // Fuzz14_084_NLRDZ
public class Fuzz14_084_NLRDZ {
    public static void test_bit_000() {
        int a = 40714; int b = 5; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_001() {
        int a = 18393; int b = 8; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_002() {
        int a = 8088; int b = 9; int c = a ^ b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_003() {
        int a = 35707; int b = 1; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_004() {
        int a = 44148; int b = 9; int c = a ^ b;
        print("bit="); println(c);
        println("OK");
    }
