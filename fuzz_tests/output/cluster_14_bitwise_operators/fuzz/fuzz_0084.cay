        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_006() {
        int a = 64370; int b = 0; int c = a ^ b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_007() {
        int a = 14616; int b = 5; int c = a >> b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_008() {
        int a = 9925; int b = 10; int c = a ^ b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_009() {
        int a = 27345; int b = 0; int c = a & b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_010() {
        int a = 45427; int b = 5; int c = a ^ b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_011() {
        int a = 37798; int b = 2; int c = a >> b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_012() {
        int a = 60823; int b = 3; int c = a >> b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_013() {
        int a = 50192; int b = 14; int c = a & b;
        print("bit="); println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_bit_000 START");
        test_bit_000();
        println("[SUB] test_bit_000 PASS");
        println("[SUB] test_bit_001 START");
        test_bit_001();
        println("[SUB] test_bit_001 PASS");
        println("[SUB] test_bit_002 START");
        test_bit_002();
        println("[SUB] test_bit_002 PASS");
        println("[SUB] test_bit_003 START");
