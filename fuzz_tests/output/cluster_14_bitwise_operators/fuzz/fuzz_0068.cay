// Fuzz Test: bitwise_operators // Fuzz14_068_HAXWV
public class Fuzz14_068_HAXWV {
    public static void test_bit_000() {
        int a = 37339; int b = 6; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_001() {
        int a = 13419; int b = 7; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
