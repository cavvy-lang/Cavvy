// Fuzz Test: bitwise_operators // Fuzz14_013_GIBMF
public class Fuzz14_013_GIBMF {
    public static void test_bit_000() {
        int a = 64199; int b = 15; int c = a & b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_001() {
        int a = 45731; int b = 2; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_002() {
        int a = 20474; int b = 13; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_003() {
        int a = 56140; int b = 8; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_004() {
        int a = 5604; int b = 8; int c = a >> b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_005() {
        int a = 44928; int b = 1; int c = a >> b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_006() {
        int a = 22450; int b = 6; int c = a ^ b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_007() {
        int a = 17413; int b = 5; int c = a ^ b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_008() {
        int a = 7898; int b = 0; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_009() {
        int a = 20528; int b = 5; int c = a ^ b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_010() {
        int a = 27842; int b = 4; int c = a ^ b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_011() {
        int a = 38415; int b = 6; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_012() {
        int a = 23995; int b = 4; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_bit_000 START");
        test_bit_000();
        println("[SUB] test_bit_000 PASS");
        println("[SUB] test_bit_001 START");
        test_bit_001();
        println("[SUB] test_bit_001 PASS");
        println("[SUB] test_bit_002 START");
        test_bit_002();
        println("[SUB] test_bit_002 PASS");
        println("[SUB] test_bit_003 START");
        test_bit_003();
        println("[SUB] test_bit_003 PASS");
        println("[SUB] test_bit_004 START");
        test_bit_004();
        println("[SUB] test_bit_004 PASS");
        println("[SUB] test_bit_005 START");
        test_bit_005();
        println("[SUB] test_bit_005 PASS");
        println("[SUB] test_bit_006 START");
        test_bit_006();
        println("[SUB] test_bit_006 PASS");
        println("[SUB] test_bit_007 START");
        test_bit_007();
        println("[SUB] test_bit_007 PASS");
        println("[SUB] test_bit_008 START");
        test_bit_008();
        println("[SUB] test_bit_008 PASS");
        println("[SUB] test_bit_009 START");
        test_bit_009();
        println("[SUB] test_bit_009 PASS");
        println("[SUB] test_bit_010 START");
        test_bit_010();
        println("[SUB] test_bit_010 PASS");
        println("[SUB] test_bit_011 START");
        test_bit_011();
        println("[SUB] test_bit_011 PASS");
        println("[SUB] test_bit_012 START");
        test_bit_012();
        println("[SUB] test_bit_012 PASS");
    }
}
