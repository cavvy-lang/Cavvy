// Fuzz Test: bitwise_operators // Fuzz14_089_KANCN
public class Fuzz14_089_KANCN {
    public static void test_bit_000() {
        int a = 61732; int b = 8; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
