    public static void test_bit_000() {
        int a = 46141; int b = 14; int c = a ^ b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_001() {
        int a = 51673; int b = 5; int c = a & b;
        print("bit="); println(c);
        println("OK");
    }
