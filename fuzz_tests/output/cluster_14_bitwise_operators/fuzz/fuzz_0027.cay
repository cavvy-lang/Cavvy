// Fuzz Test: bitwise_operators // Fuzz14_027_LNACM
public class Fuzz14_027_LNACM {
    public static void test_bit_000() {
        int a = 1392; int b = 0; int c = a | b;
        print("bit="); println(c);
        println("OK");
    }
    public static void test_bit_001() {
        int a = 33566; int b = 1; int c = a << b;
        print("bit="); println(c);
        println("OK");
    }
