// Fuzz Test: preprocessor_define // Fuzz44_084_BGSZR
public class Fuzz44_084_BGSZR {
    public static void test_def_000() {
        int v = 27;
        print("define="); println(v);
        println("OK");
    }
    public static void test_def_001() {
