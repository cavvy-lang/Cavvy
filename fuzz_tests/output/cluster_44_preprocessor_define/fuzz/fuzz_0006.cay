// Fuzz Test: preprocessor_define // Fuzz44_006_ELIMR
public class Fuzz44_006_ELIMR {
    public static void test_def_000() {
        int v = 98;
        print("define="); println(v);
        println("OK");
    }
    public static void test_def_001() {
        int v = 34;
        print("define="); println(v);
        println("OK");
    }
