// Fuzz Test: arrays_multi // Fuzz26_009_YFUIQ
public class Fuzz26_009_YFUIQ {
    public static void test_am_000() {
        int[][][] arr = new int[3][2][3];
        for(int i=0;i<3;i=i+1){
          for(int j=0;j<2;j=j+1){
            for(int k=0;k<3;k=k+1){
              arr[i][j][k]=i*100+j*10+k+1;
            }
          }
        }
        println(arr[0][0][0]);
        println("OK");
    }
