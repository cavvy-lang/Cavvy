// Fuzz Test: int_arithmetic // Fuzz01_056_TJGIH
public class Fuzz01_056_TJGIH {
    public static void test_mod_000() {
        int a = 256;
        int b = 65536;
        int c = a % b;
        print("256 % 65536 = ");
        println(c);
        if (c == 256) { println("OK"); }
    }
    public static void test_mod_001() {
        int a = 65536;
        int b = 1;
        int c = a % b;
        print("65536 % 1 = ");
        println(c);
        if (c == 0) { println("OK"); }
    }
    public static void test_mul_002() {
        int a = -32769;
        int b = 255;
        int c = a * b;
        print("-32769 * 255 = ");
        println(c);
        if (c == -8356095) { println("OK"); }
    }
    public static void test_div_003() {
        int a = 32767;
        int b = -65536;
        int c = a / b;
        print("32767 / -65536 = ");
        println(c);
        if (c == -1) { println("OK"); }
    }
    public static void test_mod_004() {
        int a = -32768;
        int b = -32768;
        int c = a % b;
        print("-32768 % -32768 = ");
        println(c);
        if (c == 0) { println("OK"); }
    }
    public static void test_mod_005() {
        int a = 100000;
        int b = -32768;
        int c = a % b;
        print("100000 % -32768 = ");
        println(c);
        if (c == -31072) { println("OK"); }
    }
    public static void test_add_006() {
        int a = -32768;
        int b = -32769;
        int c = a + b;
        print("-32768 + -32769 = ");
        println(c);
        if (c == -65537) { println("OK"); }
    }
    public static void test_add_007() {
        int a = -65536;
        int b = -32769;
        int c = a + b;
        print("-65536 + -32769 = ");
        println(c);
        if (c == -98305) { println("OK"); }
    }
    public static void test_mod_008() {
        int a = 1;
        int b = -2147483648;
        int c = a % b;
        print("1 % -2147483648 = ");
        println(c);
        if (c == -2147483647) { println("OK"); }
    }
    public static void test_add_009() {
        int a = 32767;
        int b = 2147483646;
        int c = a + b;
        print("32767 + 2147483646 = ");
        println(c);
        if (c == 2147516413) { println("OK"); }
    }
    public static void test_mod_010() {
        int a = -1;
        int b = 32768;
        int c = a % b;
        print("-1 % 32768 = ");
        println(c);
        if (c == 32767) { println("OK"); }
    }
    public static void test_div_011() {
        int a = 32768;
        int b = 2;
        int c = a / b;
        print("32768 / 2 = ");
        println(c);
        if (c == 16384) { println("OK"); }
    }
    public static void test_mul_012() {
        int a = -2147483647;
        int b = 32768;
        int c = a * b;
        print("-2147483647 * 32768 = ");
        println(c);
        if (c == -70368744144896) { println("OK"); }
    }
    public static void run_all() {
        println("[SUB] test_mod_000 START");
        test_mod_000();
        println("[SUB] test_mod_000 PASS");
        println("[SUB] test_mod_001 START");
        test_mod_001();
        println("[SUB] test_mod_001 PASS");
        println("[SUB] test_mul_002 START");
        test_mul_002();
        println("[SUB] test_mul_002 PASS");
        println("[SUB] test_div_003 START");
        test_div_003();
        println("[SUB] test_div_003 PASS");
        println("[SUB] test_mod_004 START");
        test_mod_004();
        println("[SUB] test_mod_004 PASS");
        println("[SUB] test_mod_005 START");
        test_mod_005();
        println("[SUB] test_mod_005 PASS");
        println("[SUB] test_add_006 START");
        test_add_006();
        println("[SUB] test_add_006 PASS");
        println("[SUB] test_add_007 START");
        test_add_007();
        println("[SUB] test_add_007 PASS");
        println("[SUB] test_mod_008 START");
        test_mod_008();
        println("[SUB] test_mod_008 PASS");
        println("[SUB] test_add_009 START");
        test_add_009();
        println("[SUB] test_add_009 PASS");
        println("[SUB] test_mod_010 START");
        test_mod_010();
        println("[SUB] test_mod_010 PASS");
        println("[SUB] test_div_011 START");
        test_div_011();
        println("[SUB] test_div_011 PASS");
        println("[SUB] test_mul_012 START");
        test_mul_012();
        println("[SUB] test_mul_012 PASS");
    }
}
