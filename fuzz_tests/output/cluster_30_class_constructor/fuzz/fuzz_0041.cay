        print("ctor_test="); println(x);
        println("OK");
    }
    public static void test_ctor_005() {
        int x = 94;
        print("ctor_test="); println(x);
        println("OK");
    }
    public static void test_ctor_006() {
        int x = 2;
        print("ctor_test="); println(x);
        println("OK");
    }
    public static void test_ctor_007() {
        int x = 81;
        print("ctor_test="); println(x);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_ctor_000 START");
        test_ctor_000();
        println("[SUB] test_ctor_000 PASS");
        println("[SUB] test_ctor_001 START");
        test_ctor_001();
        println("[SUB] test_ctor_001 PASS");
        println("[SUB] test_ctor_002 START");
        test_ctor_002();
        println("[SUB] test_ctor_002 PASS");
        println("[SUB] test_ctor_003 START");
