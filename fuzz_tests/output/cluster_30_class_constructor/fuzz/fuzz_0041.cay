// Fuzz Test: class_constructor // Fuzz30_041_SFTCW
public class Fuzz30_041_SFTCW {
    public static void test_ctor_000() {
        int x = 34;
        print("ctor_test="); println(x);
        println("OK");
    }
    public static void test_ctor_001() {
        int x = 0;
        print("ctor_test="); println(x);
        println("OK");
    }
    public static void test_ctor_002() {
        int x = 67;
        print("ctor_test="); println(x);
        println("OK");
    }
    public static void test_ctor_003() {
