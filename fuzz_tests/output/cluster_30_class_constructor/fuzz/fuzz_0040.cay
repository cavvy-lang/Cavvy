// Fuzz Test: class_constructor // Fuzz30_040_FCCSW
public class Fuzz30_040_FCCSW {
    public static void test_ctor_000() {
        int x = 26;
        print("ctor_test="); println(x);
        println("OK");
    }
    public static void test_ctor_001() {
        int x = 0;
        print("ctor_test="); println(x);
        println("OK");
    }
