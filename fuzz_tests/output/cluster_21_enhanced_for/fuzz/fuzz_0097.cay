// Fuzz Test: enhanced_for // Fuzz21_097_GQSXQ
public class Fuzz21_097_GQSXQ {
    public static void test_ef_000() {
        int[] arr = new int[6];
        for(int i=0;i<6;i=i+1){arr[i]=i*10+1;}
        for(int v : arr){println(v);}
        println("OK");
    }
