// Fuzz Test: type_casting // Fuzz08_078_NQBAT
public class Fuzz08_078_NQBAT {
    public static void test_cast_000() {
        double src = 3.14;
        int dst = (int)src;
        print("cast="); println(dst);
        println("OK");
    }
    public static void test_cast_001() {
        char src = 'A';
        int dst = (int)src;
        print("cast="); println(dst);
        println("OK");
    }
    public static void test_cast_002() {
        int src = 42;
        double dst = (double)src;
        print("cast="); println(dst);
        println("OK");
    }
    public static void test_cast_003() {
        char src = 'A';
        int dst = (int)src;
        print("cast="); println(dst);
        println("OK");
    }
    public static void test_cast_004() {
        int src = 42;
        double dst = (double)src;
        print("cast="); println(dst);
        println("OK");
    }
    public static void test_cast_005() {
        float src = 3.14f;
        int dst = (int)src;
        print("cast="); println(dst);
        println("OK");
    }
    public static void test_cast_006() {
        float src = 3.14f;
        int dst = (int)src;
        print("cast="); println(dst);
        println("OK");
    }
    public static void test_cast_007() {
        double src = 3.14;
        int dst = (int)src;
        print("cast="); println(dst);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_cast_000 START");
        test_cast_000();
        println("[SUB] test_cast_000 PASS");
        println("[SUB] test_cast_001 START");
        test_cast_001();
        println("[SUB] test_cast_001 PASS");
        println("[SUB] test_cast_002 START");
        test_cast_002();
        println("[SUB] test_cast_002 PASS");
        println("[SUB] test_cast_003 START");
        test_cast_003();
        println("[SUB] test_cast_003 PASS");
        println("[SUB] test_cast_004 START");
        test_cast_004();
        println("[SUB] test_cast_004 PASS");
        println("[SUB] test_cast_005 START");
        test_cast_005();
        println("[SUB] test_cast_005 PASS");
        println("[SUB] test_cast_006 START");
        test_cast_006();
        println("[SUB] test_cast_006 PASS");
        println("[SUB] test_cast_007 START");
        test_cast_007();
        println("[SUB] test_cast_007 PASS");
    }
}
