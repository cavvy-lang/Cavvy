// Fuzz Test: logical_operators // Fuzz13_064_GXDKZ
public class Fuzz13_064_GXDKZ {
    public static void test_logic_000() {
        boolean r = !(false);
        print("logic="); println(r);
        println("OK");
    }
    public static void test_logic_001() {
        boolean r = false || true;
        print("logic="); println(r);
        println("OK");
    }
    public static void test_logic_002() {
        boolean r = !(false);
        print("logic="); println(r);
        println("OK");
    }
    public static void test_logic_003() {
        boolean r = (false && true) || false;
        print("logic="); println(r);
        println("OK");
    }
    public static void test_logic_004() {
        boolean r = false || false;
        print("logic="); println(r);
        println("OK");
    }
    public static void test_logic_005() {
        boolean r = !(false && true) || true;
        print("logic="); println(r);
        println("OK");
    }
    public static void test_logic_006() {
        boolean r = !(false);
        print("logic="); println(r);
        println("OK");
    }
    public static void test_logic_007() {
        boolean r = true && true;
        print("logic="); println(r);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_logic_000 START");
        test_logic_000();
        println("[SUB] test_logic_000 PASS");
        println("[SUB] test_logic_001 START");
        test_logic_001();
        println("[SUB] test_logic_001 PASS");
        println("[SUB] test_logic_002 START");
        test_logic_002();
        println("[SUB] test_logic_002 PASS");
        println("[SUB] test_logic_003 START");
        test_logic_003();
        println("[SUB] test_logic_003 PASS");
        println("[SUB] test_logic_004 START");
        test_logic_004();
        println("[SUB] test_logic_004 PASS");
        println("[SUB] test_logic_005 START");
        test_logic_005();
        println("[SUB] test_logic_005 PASS");
        println("[SUB] test_logic_006 START");
        test_logic_006();
        println("[SUB] test_logic_006 PASS");
        println("[SUB] test_logic_007 START");
        test_logic_007();
        println("[SUB] test_logic_007 PASS");
    }
}
