// Fuzz Test: prefix_postfix // Fuzz10_070_BMGZF
public class Fuzz10_070_BMGZF {
    public static void test_pp_000() {
        int x = 90;
        int y = x--;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_001() {
