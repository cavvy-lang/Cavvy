// Fuzz Test: prefix_postfix // Fuzz10_036_SJBKM
public class Fuzz10_036_SJBKM {
    public static void test_pp_000() {
        int x = 68;
        int y = x--;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_001() {
        int x = 18;
        int y = ++x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_002() {
        int x = 0;
        int y = ++x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_003() {
        int x = 15;
        int y = ++x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_004() {
        int x = 77;
        int y = x++;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_005() {
        int x = 34;
        int y = ++x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_006() {
        int x = 2;
        int y = x--;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_007() {
        int x = 70;
        int y = x++;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_008() {
        int x = 87;
        int y = --x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_009() {
        int x = 73;
        int y = --x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_pp_000 START");
        test_pp_000();
        println("[SUB] test_pp_000 PASS");
        println("[SUB] test_pp_001 START");
        test_pp_001();
        println("[SUB] test_pp_001 PASS");
        println("[SUB] test_pp_002 START");
        test_pp_002();
        println("[SUB] test_pp_002 PASS");
        println("[SUB] test_pp_003 START");
        test_pp_003();
        println("[SUB] test_pp_003 PASS");
        println("[SUB] test_pp_004 START");
        test_pp_004();
        println("[SUB] test_pp_004 PASS");
        println("[SUB] test_pp_005 START");
        test_pp_005();
        println("[SUB] test_pp_005 PASS");
        println("[SUB] test_pp_006 START");
        test_pp_006();
        println("[SUB] test_pp_006 PASS");
        println("[SUB] test_pp_007 START");
        test_pp_007();
        println("[SUB] test_pp_007 PASS");
        println("[SUB] test_pp_008 START");
        test_pp_008();
        println("[SUB] test_pp_008 PASS");
        println("[SUB] test_pp_009 START");
        test_pp_009();
        println("[SUB] test_pp_009 PASS");
    }
}
