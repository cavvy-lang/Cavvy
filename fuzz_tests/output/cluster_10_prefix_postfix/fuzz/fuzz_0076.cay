// Fuzz Test: prefix_postfix // Fuzz10_076_NUZCU
public class Fuzz10_076_NUZCU {
    public static void test_pp_000() {
        int x = 72;
        int y = x++;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_001() {
        int x = 69;
        int y = ++x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
