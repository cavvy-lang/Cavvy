// Fuzz Test: prefix_postfix // Fuzz10_061_MRXIL
public class Fuzz10_061_MRXIL {
    public static void test_pp_000() {
        int x = 27;
        int y = ++x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_001() {
        int x = 23;
        int y = ++x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_002() {
        int x = 88;
        int y = ++x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_003() {
        int x = 2;
        int y = --x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_004() {
        int x = 60;
        int y = x++;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_005() {
        int x = 96;
        int y = --x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_006() {
        int x = 4;
        int y = ++x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void test_pp_007() {
        int x = 72;
        int y = ++x;
        print("x="); println(x);
        print("y="); println(y);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_pp_000 START");
        test_pp_000();
        println("[SUB] test_pp_000 PASS");
        println("[SUB] test_pp_001 START");
        test_pp_001();
        println("[SUB] test_pp_001 PASS");
        println("[SUB] test_pp_002 START");
        test_pp_002();
        println("[SUB] test_pp_002 PASS");
        println("[SUB] test_pp_003 START");
        test_pp_003();
        println("[SUB] test_pp_003 PASS");
        println("[SUB] test_pp_004 START");
        test_pp_004();
        println("[SUB] test_pp_004 PASS");
        println("[SUB] test_pp_005 START");
        test_pp_005();
        println("[SUB] test_pp_005 PASS");
        println("[SUB] test_pp_006 START");
        test_pp_006();
        println("[SUB] test_pp_006 PASS");
        println("[SUB] test_pp_007 START");
        test_pp_007();
        println("[SUB] test_pp_007 PASS");
    }
}
