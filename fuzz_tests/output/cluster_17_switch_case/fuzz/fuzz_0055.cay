// Fuzz Test: switch_case // Fuzz17_055_MTONZ
public class Fuzz17_055_MTONZ {
    public static void test_sw_000() {
        int x = 8;
        switch(x){
          case 0:
            println("0");
            break;
          case 2:
            println("2");
            break;
          case 9:
            println("9");
            break;
          default:
            println("default");
            break;
        }
        println("OK");
    }
