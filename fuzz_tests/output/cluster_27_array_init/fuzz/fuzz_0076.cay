    public static void test_ainit_000() {
        int[] arr = {225,565,93,809,877,63,731};
        print("len="); println(arr.length);
        for(int i=0;i<arr.length;i=i+1){println(arr[i]);}
        int[][] m2 = {{1,2,3},{4,5,6}};
        println(m2[0][0]); println(m2[1][2]);
        println("OK");
    }
