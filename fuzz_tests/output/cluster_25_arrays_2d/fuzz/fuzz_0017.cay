    public static void test_arr2_000() {
        int[][] m = new int[4][3];
        for(int i=0;i<4;i=i+1){for(int j=0;j<3;j=j+1){m[i][j]=i*3+j+1;}}
        for(int i=0;i<4;i=i+1){for(int j=0;j<3;j=j+1){println(m[i][j]);}}
        println("OK");
    }
