        int v = 1;
        print("ifdef="); println(v);
        println("OK");
    }
    public static void test_ifdef_006() {
        int v = 52;
        print("ifdef="); println(v);
        println("OK");
    }
    public static void test_ifdef_007() {
        int v = 0;
        print("ifdef="); println(v);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_ifdef_000 START");
