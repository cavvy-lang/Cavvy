// Fuzz Test: preprocessor_ifdef // Fuzz45_070_NSMJL
public class Fuzz45_070_NSMJL {
    public static void test_ifdef_000() {
        int v = 52;
        print("ifdef="); println(v);
        println("OK");
    }
    public static void test_ifdef_001() {
        int v = 32;
        print("ifdef="); println(v);
        println("OK");
    }
    public static void test_ifdef_002() {
