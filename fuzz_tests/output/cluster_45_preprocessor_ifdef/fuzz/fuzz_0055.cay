// Fuzz Test: preprocessor_ifdef // Fuzz45_055_HPZOM
public class Fuzz45_055_HPZOM {
    public static void test_ifdef_000() {
        int v = 13;
        print("ifdef="); println(v);
        println("OK");
    }
    public static void test_ifdef_001() {
        int v = 69;
        print("ifdef="); println(v);
