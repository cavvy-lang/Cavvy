// Fuzz Test: char_operations // Fuzz04_007_MFTZQ
public class Fuzz04_007_MFTZQ {
    public static void test_char_000() {
        char a = '$';
        char b = '2';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = '/';
        char b = '^';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_002() {
        char a = '=';
        char b = 'n';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
