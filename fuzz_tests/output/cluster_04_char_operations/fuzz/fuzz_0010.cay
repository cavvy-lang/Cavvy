// Fuzz Test: char_operations // Fuzz04_010_QMXVL
public class Fuzz04_010_QMXVL {
    public static void test_char_000() {
        char a = '%';
        char b = 'n';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
