// Fuzz Test: char_operations // Fuzz04_004_UPBFD
public class Fuzz04_004_UPBFD {
    public static void test_char_000() {
        char a = 'G';
        char b = 'b';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
