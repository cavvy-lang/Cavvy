// Fuzz Test: char_operations // Fuzz04_075_IEWWA
public class Fuzz04_075_IEWWA {
    public static void test_char_000() {
        char a = 'K';
        char b = 'I';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
