// Fuzz Test: char_operations // Fuzz04_028_OOSTT
public class Fuzz04_028_OOSTT {
    public static void test_char_000() {
        char a = 'f';
        char b = 'M';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = '4';
        char b = '7';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_002() {
        char a = 'v';
        char b = '^';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_003() {
        char a = 'H';
        char b = 'C';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_004() {
        char a = 'X';
        char b = '_';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_005() {
        char a = '<';
