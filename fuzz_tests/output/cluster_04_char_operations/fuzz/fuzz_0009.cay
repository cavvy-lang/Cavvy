// Fuzz Test: char_operations // Fuzz04_009_HURVO
public class Fuzz04_009_HURVO {
    public static void test_char_000() {
        char a = 'Z';
        char b = '^';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = '0';
        char b = '(';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_002() {
        char a = 'z';
        char b = '6';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_003() {
        char a = 'P';
        char b = 'o';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_004() {
        char a = 'S';
        char b = 'k';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_005() {
        char a = '!';
        char b = 'n';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_006() {
        char a = '%';
        char b = 'O';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_007() {
        char a = 'V';
        char b = 'Q';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_char_000 START");
        test_char_000();
        println("[SUB] test_char_000 PASS");
        println("[SUB] test_char_001 START");
        test_char_001();
        println("[SUB] test_char_001 PASS");
        println("[SUB] test_char_002 START");
        test_char_002();
        println("[SUB] test_char_002 PASS");
        println("[SUB] test_char_003 START");
        test_char_003();
        println("[SUB] test_char_003 PASS");
        println("[SUB] test_char_004 START");
        test_char_004();
        println("[SUB] test_char_004 PASS");
        println("[SUB] test_char_005 START");
        test_char_005();
        println("[SUB] test_char_005 PASS");
        println("[SUB] test_char_006 START");
        test_char_006();
        println("[SUB] test_char_006 PASS");
        println("[SUB] test_char_007 START");
        test_char_007();
        println("[SUB] test_char_007 PASS");
    }
}
