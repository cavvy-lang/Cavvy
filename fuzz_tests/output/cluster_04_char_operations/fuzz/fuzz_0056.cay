// Fuzz Test: char_operations // Fuzz04_056_BAFNE
public class Fuzz04_056_BAFNE {
    public static void test_char_000() {
        char a = 'O';
        char b = 'v';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = '@';
        char b = 'f';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_002() {
        char a = 'c';
        char b = 'Q';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_003() {
        char a = '?';
        char b = '0';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_004() {
