// Fuzz Test: char_operations // Fuzz04_088_CJIBS
public class Fuzz04_088_CJIBS {
    public static void test_char_000() {
        char a = '>';
        char b = '1';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
