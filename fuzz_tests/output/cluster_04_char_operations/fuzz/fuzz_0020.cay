// Fuzz Test: char_operations // Fuzz04_020_UJTWX
public class Fuzz04_020_UJTWX {
    public static void test_char_000() {
        char a = '3';
        char b = 'o';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
