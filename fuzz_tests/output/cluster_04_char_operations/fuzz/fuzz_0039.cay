// Fuzz Test: char_operations // Fuzz04_039_CEZOM
public class Fuzz04_039_CEZOM {
    public static void test_char_000() {
        char a = '>';
        char b = 'A';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = 'e';
        char b = '>';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
