// Fuzz Test: char_operations // Fuzz04_055_IDNLY
public class Fuzz04_055_IDNLY {
    public static void test_char_000() {
        char a = 'e';
        char b = '_';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
