// Fuzz Test: char_operations // Fuzz04_084_PGYPQ
public class Fuzz04_084_PGYPQ {
    public static void test_char_000() {
        char a = 's';
        char b = 'b';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = '@';
