// Fuzz Test: char_operations // Fuzz04_083_MONFG
public class Fuzz04_083_MONFG {
    public static void test_char_000() {
        char a = '9';
        char b = 'B';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = '5';
        char b = 'q';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_002() {
        char a = ';';
