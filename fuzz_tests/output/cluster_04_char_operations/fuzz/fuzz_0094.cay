// Fuzz Test: char_operations // Fuzz04_094_RPBEU
public class Fuzz04_094_RPBEU {
    public static void test_char_000() {
        char a = '1';
        char b = 'U';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
