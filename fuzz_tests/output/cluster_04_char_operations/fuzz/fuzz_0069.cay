// Fuzz Test: char_operations // Fuzz04_069_NKBCU
public class Fuzz04_069_NKBCU {
    public static void test_char_000() {
        char a = 'H';
        char b = '*';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
