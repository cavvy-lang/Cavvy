// Fuzz Test: char_operations // Fuzz04_090_OOBBX
public class Fuzz04_090_OOBBX {
    public static void test_char_000() {
        char a = 'N';
        char b = 'z';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = '-';
        char b = 'F';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_002() {
        char a = '5';
        char b = '!';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_003() {
        char a = '?';
        char b = 'h';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_004() {
        char a = '/';
