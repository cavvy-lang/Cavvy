// Fuzz Test: char_operations // Fuzz04_068_TCXLC
public class Fuzz04_068_TCXLC {
    public static void test_char_000() {
        char a = 't';
        char b = '%';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
