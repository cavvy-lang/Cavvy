// Fuzz Test: char_operations // Fuzz04_025_MHAMN
public class Fuzz04_025_MHAMN {
    public static void test_char_000() {
        char a = 'f';
        char b = '|';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
