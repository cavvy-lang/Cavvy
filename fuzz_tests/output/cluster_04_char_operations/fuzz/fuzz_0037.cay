// Fuzz Test: char_operations // Fuzz04_037_YXKUP
public class Fuzz04_037_YXKUP {
    public static void test_char_000() {
        char a = '4';
        char b = 'g';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
