// Fuzz Test: char_operations // Fuzz04_086_YMDQW
public class Fuzz04_086_YMDQW {
    public static void test_char_000() {
        char a = '/';
        char b = 'V';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = 'c';
        char b = 'v';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_002() {
        char a = '7';
        char b = 'K';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_003() {
        char a = 'O';
