// Fuzz Test: char_operations // Fuzz04_061_EVXDE
public class Fuzz04_061_EVXDE {
    public static void test_char_000() {
        char a = 'C';
        char b = '=';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
