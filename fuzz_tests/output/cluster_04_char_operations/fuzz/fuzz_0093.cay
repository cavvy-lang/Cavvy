// Fuzz Test: char_operations // Fuzz04_093_FERWX
public class Fuzz04_093_FERWX {
    public static void test_char_000() {
        char a = ':';
        char b = 'J';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = '[';
        char b = 'i';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
