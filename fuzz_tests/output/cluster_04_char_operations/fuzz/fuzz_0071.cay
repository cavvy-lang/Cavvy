// Fuzz Test: char_operations // Fuzz04_071_OLNEE
public class Fuzz04_071_OLNEE {
    public static void test_char_000() {
        char a = '-';
        char b = 'U';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = '6';
        char b = 'l';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
