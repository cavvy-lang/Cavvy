// Fuzz Test: char_operations // Fuzz04_033_UHZUM
public class Fuzz04_033_UHZUM {
    public static void test_char_000() {
        char a = '4';
        char b = 'q';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = 'R';
        char b = '#';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_002() {
        char a = '$';
        char b = 'P';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_003() {
        char a = '>';
