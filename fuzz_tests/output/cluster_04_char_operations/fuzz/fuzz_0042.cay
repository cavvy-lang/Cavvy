// Fuzz Test: char_operations // Fuzz04_042_BLDQS
public class Fuzz04_042_BLDQS {
    public static void test_char_000() {
        char a = '8';
        char b = 'K';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = 'Z';
        char b = '?';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
