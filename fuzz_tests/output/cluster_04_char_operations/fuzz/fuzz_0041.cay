// Fuzz Test: char_operations // Fuzz04_041_VJLCX
public class Fuzz04_041_VJLCX {
    public static void test_char_000() {
        char a = '0';
        char b = 'p';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
