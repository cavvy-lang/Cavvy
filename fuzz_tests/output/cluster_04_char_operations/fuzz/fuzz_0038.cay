// Fuzz Test: char_operations // Fuzz04_038_GEDQJ
public class Fuzz04_038_GEDQJ {
    public static void test_char_000() {
        char a = 'X';
        char b = '9';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = 'O';
        char b = '#';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_002() {
        char a = 'b';
        char b = '0';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_003() {
        char a = '3';
