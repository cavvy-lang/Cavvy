// Fuzz Test: char_operations // Fuzz04_012_GKXTK
public class Fuzz04_012_GKXTK {
    public static void test_char_000() {
        char a = '2';
        char b = 'V';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = 'n';
        char b = 'M';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
