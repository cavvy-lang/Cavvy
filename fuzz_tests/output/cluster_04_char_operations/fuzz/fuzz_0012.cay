    public static void run_all() {
        println("[SUB] test_char_000 START");
        test_char_000();
        println("[SUB] test_char_000 PASS");
        println("[SUB] test_char_001 START");
        test_char_001();
        println("[SUB] test_char_001 PASS");
        println("[SUB] test_char_002 START");
        test_char_002();
        println("[SUB] test_char_002 PASS");
        println("[SUB] test_char_003 START");
        test_char_003();
        println("[SUB] test_char_003 PASS");
        println("[SUB] test_char_004 START");
