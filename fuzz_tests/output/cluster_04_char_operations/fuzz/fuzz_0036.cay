// Fuzz Test: char_operations // Fuzz04_036_XHPBN
public class Fuzz04_036_XHPBN {
    public static void test_char_000() {
        char a = '=';
        char b = 'B';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
