// Fuzz Test: char_operations // Fuzz04_047_QRZXG
public class Fuzz04_047_QRZXG {
    public static void test_char_000() {
        char a = 'A';
        char b = 'S';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = 'v';
        char b = '(';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
