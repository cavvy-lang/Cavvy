// Fuzz Test: char_operations // Fuzz04_014_AVGMD
public class Fuzz04_014_AVGMD {
    public static void test_char_000() {
        char a = 'm';
        char b = 'g';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
