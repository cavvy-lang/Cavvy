// Fuzz Test: char_operations // Fuzz04_062_HKGTN
public class Fuzz04_062_HKGTN {
    public static void test_char_000() {
        char a = '+';
        char b = 'k';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
