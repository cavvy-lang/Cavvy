// Fuzz Test: char_operations // Fuzz04_026_OXFIL
public class Fuzz04_026_OXFIL {
    public static void test_char_000() {
        char a = ')';
        char b = 't';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
