// Fuzz Test: char_operations // Fuzz04_072_PSEVM
public class Fuzz04_072_PSEVM {
    public static void test_char_000() {
        char a = '+';
        char b = 'e';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_001() {
        char a = '%';
        char b = '6';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
    public static void test_char_002() {
        char a = 'v';
        char b = 'X';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
