// Fuzz Test: char_operations // Fuzz04_098_QONAC
public class Fuzz04_098_QONAC {
    public static void test_char_000() {
        char a = 'C';
        char b = '3';
        print("char test: ");
        print(a);
        print(" vs ");
        println(b);
        println("OK");
    }
