// Fuzz Test: float_operations // Fuzz02_031_SGABD
public class Fuzz02_031_SGABD {
    public static void test_fp_000() {
        double a = -1e-308;
        double b = -0.0;
        double c = a * b;
        print("double * result=");
        println(c);
        println("OK");
    }
    public static void test_fp_001() {
        double a = 1e-05;
        double b = 3.14159;
        double c = a - b;
        print("double - result=");
        println(c);
        println("OK");
    }
    public static void test_fp_002() {
        float a = 1.41421;
        float b = -3.40282e+38;
        float c = a - b;
        print("float - result=");
        println(c);
        println("OK");
    }
    public static void test_fp_003() {
        float a = 2.71828;
        float b = -2.71828;
        float c = a / b;
        print("float / result=");
        println(c);
        println("OK");
    }
    public static void test_fp_004() {
        double a = -2.71828;
        double b = 1.0;
        double c = a / b;
        print("double / result=");
        println(c);
        println("OK");
    }
    public static void test_fp_005() {
        float a = 0.5;
        float b = -0.0;
        float c = a * b;
        print("float * result=");
        println(c);
        println("OK");
    }
    public static void test_fp_006() {
        double a = 0.0;
        double b = 1e-308;
        double c = a + b;
        print("double + result=");
        println(c);
        println("OK");
    }
    public static void test_fp_007() {
        double a = 3.14159;
        double b = -1e-05;
        double c = a - b;
        print("double - result=");
        println(c);
        println("OK");
    }
    public static void test_fp_008() {
        float a = -1.0;
        float b = 0.5;
        float c = a * b;
        print("float * result=");
        println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_fp_000 START");
        test_fp_000();
        println("[SUB] test_fp_000 PASS");
        println("[SUB] test_fp_001 START");
        test_fp_001();
        println("[SUB] test_fp_001 PASS");
        println("[SUB] test_fp_002 START");
        test_fp_002();
        println("[SUB] test_fp_002 PASS");
        println("[SUB] test_fp_003 START");
        test_fp_003();
        println("[SUB] test_fp_003 PASS");
        println("[SUB] test_fp_004 START");
        test_fp_004();
        println("[SUB] test_fp_004 PASS");
        println("[SUB] test_fp_005 START");
        test_fp_005();
        println("[SUB] test_fp_005 PASS");
        println("[SUB] test_fp_006 START");
        test_fp_006();
        println("[SUB] test_fp_006 PASS");
        println("[SUB] test_fp_007 START");
        test_fp_007();
        println("[SUB] test_fp_007 PASS");
        println("[SUB] test_fp_008 START");
        test_fp_008();
        println("[SUB] test_fp_008 PASS");
    }
}
