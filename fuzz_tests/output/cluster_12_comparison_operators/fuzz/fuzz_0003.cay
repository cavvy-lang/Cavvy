// Fuzz Test: comparison_operators // Fuzz12_003_DNKSI
public class Fuzz12_003_DNKSI {
    public static void test_cmp_000() {
        int a = -85; int b = -17; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = 36; int b = 43; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_002() {
        int a = 71; int b = 1; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_003() {
        int a = 34; int b = 26; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_004() {
        int a = -39; int b = -20; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_005() {
        int a = 94; int b = 27; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_006() {
        int a = -71; int b = 42; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_007() {
        int a = 45; int b = -98; boolean c = a < b;
