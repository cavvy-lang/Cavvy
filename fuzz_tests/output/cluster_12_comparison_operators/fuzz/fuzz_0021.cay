// Fuzz Test: comparison_operators // Fuzz12_021_MBCCU
public class Fuzz12_021_MBCCU {
    public static void test_cmp_000() {
        int a = 45; int b = 12; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = -55; int b = -51; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_002() {
        int a = 100; int b = -2; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_003() {
        int a = 45; int b = -22; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_004() {
        int a = 90; int b = -60; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_005() {
        int a = -74; int b = 87; boolean c = a <= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_006() {
        int a = -31; int b = -40; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_007() {
        int a = -59; int b = 29; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_008() {
        int a = 98; int b = -73; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_009() {
        int a = 75; int b = 20; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_010() {
        int a = -98; int b = -29; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_011() {
        int a = 27; int b = 4; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_cmp_000 START");
        test_cmp_000();
        println("[SUB] test_cmp_000 PASS");
        println("[SUB] test_cmp_001 START");
        test_cmp_001();
        println("[SUB] test_cmp_001 PASS");
        println("[SUB] test_cmp_002 START");
