// Fuzz Test: comparison_operators // Fuzz12_082_EKAQT
public class Fuzz12_082_EKAQT {
    public static void test_cmp_000() {
        int a = -61; int b = 94; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = 8; int b = -42; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_002() {
        int a = 99; int b = -28; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_003() {
        int a = -33; int b = 88; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
