        println("OK");
    }
    public static void test_cmp_008() {
        int a = 63; int b = -61; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_009() {
        int a = 13; int b = -10; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_010() {
        int a = -38; int b = 72; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_cmp_000 START");
        test_cmp_000();
        println("[SUB] test_cmp_000 PASS");
        println("[SUB] test_cmp_001 START");
        test_cmp_001();
        println("[SUB] test_cmp_001 PASS");
        println("[SUB] test_cmp_002 START");
