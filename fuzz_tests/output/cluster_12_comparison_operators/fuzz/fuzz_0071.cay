// Fuzz Test: comparison_operators // Fuzz12_071_YWSRQ
public class Fuzz12_071_YWSRQ {
    public static void test_cmp_000() {
        int a = -1; int b = -91; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = -78; int b = 59; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_002() {
        int a = -39; int b = 49; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_003() {
        int a = 57; int b = -52; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_004() {
        int a = -45; int b = 6; boolean c = a <= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_005() {
        int a = -4; int b = 87; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_006() {
