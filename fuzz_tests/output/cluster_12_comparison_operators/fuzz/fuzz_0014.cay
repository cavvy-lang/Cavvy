// Fuzz Test: comparison_operators // Fuzz12_014_YFYBE
public class Fuzz12_014_YFYBE {
    public static void test_cmp_000() {
        int a = 2; int b = -68; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = 28; int b = 67; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_002() {
        int a = 42; int b = -38; boolean c = a <= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_003() {
