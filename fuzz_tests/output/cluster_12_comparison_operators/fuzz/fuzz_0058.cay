// Fuzz Test: comparison_operators // Fuzz12_058_YLGLB
public class Fuzz12_058_YLGLB {
    public static void test_cmp_000() {
        int a = -71; int b = -1; boolean c = a <= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = 61; int b = 76; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
