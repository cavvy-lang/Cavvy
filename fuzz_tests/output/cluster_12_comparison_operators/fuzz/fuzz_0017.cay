// Fuzz Test: comparison_operators // Fuzz12_017_WHOPR
public class Fuzz12_017_WHOPR {
    public static void test_cmp_000() {
        int a = -14; int b = 63; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = -49; int b = 76; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
