    }
    public static void test_cmp_010() {
        int a = 23; int b = 47; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_011() {
        int a = -26; int b = -54; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_cmp_000 START");
