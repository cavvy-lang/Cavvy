// Fuzz Test: comparison_operators // Fuzz12_067_HAENQ
public class Fuzz12_067_HAENQ {
    public static void test_cmp_000() {
        int a = 28; int b = 69; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = 61; int b = 26; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
