        println("OK");
    }
    public static void test_cmp_008() {
        int a = 2; int b = 27; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_009() {
        int a = -69; int b = 67; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_010() {
        int a = 3; int b = 36; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_011() {
        int a = -36; int b = 34; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_cmp_000 START");
        test_cmp_000();
        println("[SUB] test_cmp_000 PASS");
        println("[SUB] test_cmp_001 START");
