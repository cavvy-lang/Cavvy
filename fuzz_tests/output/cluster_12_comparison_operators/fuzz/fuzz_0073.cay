// Fuzz Test: comparison_operators // Fuzz12_073_MGQYP
public class Fuzz12_073_MGQYP {
    public static void test_cmp_000() {
        int a = -60; int b = -45; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = -62; int b = -10; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_002() {
        int a = -5; int b = 39; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_003() {
        int a = -44; int b = -53; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_004() {
        int a = -64; int b = 67; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_005() {
        int a = 19; int b = 83; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_006() {
        int a = 63; int b = 4; boolean c = a != b;
