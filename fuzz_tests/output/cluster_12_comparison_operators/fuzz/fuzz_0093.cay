// Fuzz Test: comparison_operators // Fuzz12_093_ARXAF
public class Fuzz12_093_ARXAF {
    public static void test_cmp_000() {
        int a = -84; int b = 50; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = 54; int b = 30; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
