// Fuzz Test: comparison_operators // Fuzz12_004_RAMJZ
public class Fuzz12_004_RAMJZ {
    public static void test_cmp_000() {
        int a = -48; int b = -44; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = 91; int b = 97; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_002() {
        int a = -42; int b = -91; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_003() {
        int a = 57; int b = 98; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_004() {
        int a = -62; int b = -24; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_005() {
        int a = -98; int b = 92; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_006() {
        int a = 35; int b = -6; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_007() {
        int a = -65; int b = -38; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_008() {
        int a = 91; int b = 6; boolean c = a <= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_009() {
        int a = -85; int b = 75; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_010() {
        int a = -86; int b = 93; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_cmp_000 START");
        test_cmp_000();
        println("[SUB] test_cmp_000 PASS");
        println("[SUB] test_cmp_001 START");
        test_cmp_001();
        println("[SUB] test_cmp_001 PASS");
        println("[SUB] test_cmp_002 START");
        test_cmp_002();
        println("[SUB] test_cmp_002 PASS");
        println("[SUB] test_cmp_003 START");
        test_cmp_003();
        println("[SUB] test_cmp_003 PASS");
        println("[SUB] test_cmp_004 START");
        test_cmp_004();
        println("[SUB] test_cmp_004 PASS");
        println("[SUB] test_cmp_005 START");
        test_cmp_005();
        println("[SUB] test_cmp_005 PASS");
        println("[SUB] test_cmp_006 START");
        test_cmp_006();
        println("[SUB] test_cmp_006 PASS");
        println("[SUB] test_cmp_007 START");
        test_cmp_007();
        println("[SUB] test_cmp_007 PASS");
        println("[SUB] test_cmp_008 START");
        test_cmp_008();
        println("[SUB] test_cmp_008 PASS");
        println("[SUB] test_cmp_009 START");
        test_cmp_009();
        println("[SUB] test_cmp_009 PASS");
        println("[SUB] test_cmp_010 START");
        test_cmp_010();
        println("[SUB] test_cmp_010 PASS");
