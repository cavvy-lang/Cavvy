// Fuzz Test: comparison_operators // Fuzz12_027_GUSXG
public class Fuzz12_027_GUSXG {
    public static void test_cmp_000() {
        int a = -34; int b = 55; boolean c = a <= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = 17; int b = -42; boolean c = a <= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_002() {
        int a = -65; int b = -44; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_003() {
