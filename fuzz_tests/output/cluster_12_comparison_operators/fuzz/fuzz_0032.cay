// Fuzz Test: comparison_operators // Fuzz12_032_ERVBD
public class Fuzz12_032_ERVBD {
    public static void test_cmp_000() {
        int a = -49; int b = -74; boolean c = a <= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = -28; int b = 14; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_002() {
        int a = 35; int b = 46; boolean c = a <= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_003() {
        int a = 49; int b = -23; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_004() {
        int a = 23; int b = -37; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_005() {
        int a = 45; int b = 50; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_006() {
        int a = 86; int b = -44; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
