// Fuzz Test: comparison_operators // Fuzz12_095_UMWET
public class Fuzz12_095_UMWET {
    public static void test_cmp_000() {
        int a = 10; int b = -57; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = -91; int b = -5; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
