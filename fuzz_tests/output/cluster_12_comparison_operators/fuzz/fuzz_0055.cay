// Fuzz Test: comparison_operators // Fuzz12_055_JEXYJ
public class Fuzz12_055_JEXYJ {
    public static void test_cmp_000() {
        int a = 99; int b = 94; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = 17; int b = -30; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_002() {
        int a = 52; int b = -82; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_003() {
        int a = -27; int b = 67; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_004() {
        int a = -33; int b = -65; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_005() {
        int a = 56; int b = -43; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_006() {
        int a = -93; int b = 70; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_007() {
        int a = -69; int b = 11; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_008() {
        int a = -30; int b = -93; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_cmp_000 START");
        test_cmp_000();
        println("[SUB] test_cmp_000 PASS");
        println("[SUB] test_cmp_001 START");
        test_cmp_001();
        println("[SUB] test_cmp_001 PASS");
        println("[SUB] test_cmp_002 START");
        test_cmp_002();
        println("[SUB] test_cmp_002 PASS");
        println("[SUB] test_cmp_003 START");
        test_cmp_003();
        println("[SUB] test_cmp_003 PASS");
        println("[SUB] test_cmp_004 START");
        test_cmp_004();
        println("[SUB] test_cmp_004 PASS");
        println("[SUB] test_cmp_005 START");
        test_cmp_005();
        println("[SUB] test_cmp_005 PASS");
        println("[SUB] test_cmp_006 START");
        test_cmp_006();
        println("[SUB] test_cmp_006 PASS");
        println("[SUB] test_cmp_007 START");
        test_cmp_007();
        println("[SUB] test_cmp_007 PASS");
        println("[SUB] test_cmp_008 START");
        test_cmp_008();
        println("[SUB] test_cmp_008 PASS");
    }
}
