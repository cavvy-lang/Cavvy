// Fuzz Test: comparison_operators // Fuzz12_024_STBOQ
public class Fuzz12_024_STBOQ {
    public static void test_cmp_000() {
        int a = -3; int b = 88; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = 59; int b = 73; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
