// Fuzz Test: comparison_operators // Fuzz12_083_NXBAH
public class Fuzz12_083_NXBAH {
    public static void test_cmp_000() {
        int a = -68; int b = 22; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
