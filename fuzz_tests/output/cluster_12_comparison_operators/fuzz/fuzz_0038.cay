    }
    public static void test_cmp_009() {
        int a = -68; int b = -50; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_010() {
        int a = 17; int b = -17; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_011() {
        int a = -8; int b = 48; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_cmp_000 START");
        test_cmp_000();
        println("[SUB] test_cmp_000 PASS");
        println("[SUB] test_cmp_001 START");
