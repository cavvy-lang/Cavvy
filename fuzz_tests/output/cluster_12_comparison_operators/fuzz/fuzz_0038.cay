// Fuzz Test: comparison_operators // Fuzz12_038_WKTUI
public class Fuzz12_038_WKTUI {
    public static void test_cmp_000() {
        int a = 74; int b = 6; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = 57; int b = 37; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_002() {
        int a = 84; int b = 44; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_003() {
        int a = -89; int b = -26; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_004() {
        int a = -8; int b = 53; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_005() {
        int a = 21; int b = 29; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_006() {
