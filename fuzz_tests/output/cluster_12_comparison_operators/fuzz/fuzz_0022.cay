// Fuzz Test: comparison_operators // Fuzz12_022_ICVMO
public class Fuzz12_022_ICVMO {
    public static void test_cmp_000() {
        int a = -36; int b = 79; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
