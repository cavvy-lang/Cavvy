// Fuzz Test: comparison_operators // Fuzz12_033_FWGPZ
public class Fuzz12_033_FWGPZ {
    public static void test_cmp_000() {
        int a = 25; int b = 93; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = 83; int b = -77; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_002() {
        int a = -15; int b = -50; boolean c = a <= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_003() {
        int a = 55; int b = 100; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_004() {
        int a = -96; int b = 14; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_005() {
        int a = -13; int b = -92; boolean c = a == b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_006() {
        int a = 8; int b = -44; boolean c = a <= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_007() {
        int a = 39; int b = 43; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_008() {
        int a = 45; int b = 3; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_009() {
        int a = -20; int b = -84; boolean c = a > b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_010() {
        int a = -23; int b = 3; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_011() {
        int a = -69; int b = 4; boolean c = a >= b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void run_all() {
        println("[SUB] test_cmp_000 START");
        test_cmp_000();
        println("[SUB] test_cmp_000 PASS");
        println("[SUB] test_cmp_001 START");
        test_cmp_001();
        println("[SUB] test_cmp_001 PASS");
        println("[SUB] test_cmp_002 START");
