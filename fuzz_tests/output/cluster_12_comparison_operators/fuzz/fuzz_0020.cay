// Fuzz Test: comparison_operators // Fuzz12_020_GUDGH
public class Fuzz12_020_GUDGH {
    public static void test_cmp_000() {
        int a = -79; int b = 75; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = -39; int b = -98; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
