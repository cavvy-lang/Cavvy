// Fuzz Test: comparison_operators // Fuzz12_062_VYRXV
public class Fuzz12_062_VYRXV {
    public static void test_cmp_000() {
        int a = 29; int b = -61; boolean c = a < b;
        print("cmp="); println(c);
        println("OK");
    }
    public static void test_cmp_001() {
        int a = -37; int b = 63; boolean c = a != b;
        print("cmp="); println(c);
        println("OK");
    }
