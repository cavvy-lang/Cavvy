// 多维数组 + 数组长度回归：
// 1. graph 的外层指针数组必须有长度头，graph.length 才正确；
// 2. 每一行必须按元素（int，4 字节）分配，而不是按 int[] 指针分配。
public class Helper {
    public static final int INF = 0x3f3f3f3f;

    public static int[] dijkstra(int[][] graph, int source) {
        int n = graph.length - 1;
        int[] dist = new int[n + 1]();
        bool[] vis = new bool[n + 1]();
        for (int i = 0; i <= n; i++) { dist[i] = INF; }
        dist[source] = 0;

        for (int i = 1; i <= n; i++) {
            int t = -1;
            for (int j = 1; j <= n; j++) {
                if (!vis[j] && (t == -1 || dist[j] < dist[t])) {
                    t = j;
                }
            }
            if (t == -1 || dist[t] == INF) {
                break;
            }
            vis[t] = true;
            for (int j = 1; j <= n; j++) {
                if (graph[t][j] == INF) {
                    continue;
                }
                int newDistance = dist[t] + graph[t][j];
                if (newDistance < dist[j]) {
                    dist[j] = newDistance;
                }
            }
        }
        return dist;
    }
}

public class Main {
    public static void main() {
        int n = 4;
        int[][] graph = new int[n + 1][n + 1]();
        for (int i = 0; i <= n; i++) {
            for (int j = 0; j <= n; j++) {
                graph[i][j] = Helper.INF;
            }
        }
        for (int i = 0; i <= n; i++) { graph[i][i] = 0; }
        graph[1][2] = 2; graph[2][1] = 2;
        graph[2][3] = 2; graph[3][2] = 2;
        graph[2][4] = 1; graph[4][2] = 1;
        graph[1][3] = 5; graph[3][1] = 5;
        graph[3][4] = 3; graph[4][3] = 3;
        graph[1][4] = 4; graph[4][1] = 4;

        int[] dist = Helper::dijkstra(graph, 1);
        for (int i = 1; i <= n; i++) {
            print("{} ", dist[i]);
        }
    }
}
