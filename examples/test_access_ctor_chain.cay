
public class Base {
    private int secret;
    
    protected Base(int s) {
        this.secret = s;
    }
    
    public int getSecret() {
        return this.secret;
    }
}

public class Derived extends Base {
    public Derived(int s) {
        super(s);
    }
    
    public static void main() {
        Derived d = new Derived(42);
        println(String.valueOf(d.getSecret()));
    }
}
