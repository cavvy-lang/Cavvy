// helper.cayh —— helper.cay 的声明文件（类比 C++ 的 .hpp）
//
// 与 .h/.hpp 不同：.cayh 是 Cavvy 源码，可以直接声明高级 ADT（enum 等）。
// 约定：.cayh 只放"声明"——类型定义（enum 及其 impl 方法块）、类的成员
// 签名（native，无方法体）、#define 常量；实现全部在对应的 .cay 中，
// 经 cayc helper.cay main.cay 分别编译后链接。

// 高级 ADT：enum 定义可以直接放在头文件中
public enum Color {
    Red,
    Green,
    Blue
}

// enum 的方法（impl 块）也可以放头文件：各编译单元各自生成定义，
// 由链接器按 linkonce_odr 去重（与 C++ 的 inline 函数同理）
impl Color {
    public int index() {
        switch (this) {
            case Color.Red: { return 0; }
            case Color.Green: { return 1; }
            case Color.Blue: { return 2; }
            default: { return -1; }
        }
    }
}

// 类声明：与 C++ 头文件中的类定义一样——字段照列，方法只写签名（native）。
// 实现由 helper.cay 提供；native 成员在 codegen 只产生 declare。
public class Helper {
    // 实例字段（布局镜像，与实现文件保持一致）
    private int base;

    public native Helper(int b);
    public native ~Helper();

    public native static int add(int a, int b);
    public native static Color favorite();
    public native int scale(int factor);
}
