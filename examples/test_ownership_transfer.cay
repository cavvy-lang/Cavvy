#include <std/arraylist.cay>
#include <c/stdio.cay>

using std::ArrayList;

public int main() {
    ArrayList<int> row = new ArrayList<int>();
    row.add(1);
    row.add(2);

    ArrayList<ArrayList<int>> matrix = new ArrayList<ArrayList<int>>();
    matrix.add(row);

    println("matrix[0][0] = " + String.valueOf(matrix.get(0).get(0)));
    println("matrix[0][1] = " + String.valueOf(matrix.get(0).get(1)));
    return 0;
}
