/**
 * 类型声明集成测试
 * 测试内容: 各种基础类型的声明、数组声明、类型推断
 */
public class TestTypeOnly {
    public static void main() {
        println("=== 类型声明测试 ===");

        // 基础类型声明
        int i = 10;
        long l = 100L;
        float f = 3.14f;
        double d = 2.71828;
        boolean b = true;
        char c = 'X';
        String s = "Hello";

        println("int: " + String.valueOf(i));
        println("long: " + String.valueOf(l));
        println("float: " + String.valueOf(f));
        println("double: " + String.valueOf(d));
        if (b) { println("boolean: true"); }
        println("char: " + String.valueOf((int)c));
        println("String: " + s);

        // 数组声明
        int[] arr1;
        arr1 = new int[5];
        arr1[0] = 1;
        arr1[4] = 5;
        println("数组 arr1[0] = " + String.valueOf(arr1[0]));
        println("数组 arr1[4] = " + String.valueOf(arr1[4]));

        // 多维数组声明
        int[][] arr2;
        arr2 = new int[2][3];

        // 初始化器声明
        int[] arr3 = {10, 20, 30};
        println("arr3.length = " + String.valueOf(arr3.length));

        // 类型推断 (auto)
        auto x = 42;
        auto y = "auto string";
        println("auto int: " + String.valueOf(x));
        println("auto string: " + y);

        println("=== 类型声明测试完成 ===");
    }
}
