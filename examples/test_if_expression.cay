// if 表达式测试 (6.2.x 新语法)
// 覆盖：基本分支值、String 分支、数值提升、多语句分支、
// 嵌套 if 表达式、用作函数实参与 return 值
class Calc {
    public static fn triple(v: i32) -> i32 { v * 3 }
}

fn pick(flag: boolean) -> int {
    if (flag) { 7 } else { 9 }
}

fn main() {
    // 1. 基本 int 分支
    int a = 10;
    int x = if (a > 5) { 100 } else { 200 };
    println(x);                                 // 100

    // 2. String 分支
    String s = if (a > 50) { "big" } else { "small" };
    println(s);                                 // small

    // 3. let 推导
    let y = if (a > 5) { 1 } else { 0 };
    println(y);                                 // 1

    // 4. 数值提升（int + long -> long）
    long big = if (a > 5) { 5 } else { 10L };
    println(big);                               // 5

    // 5. 多语句分支 + 尾值
    int z = if (a > 5) {
        int t = a * 2;
        t + 1
    } else {
        0
    };
    println(z);                                 // 21

    // 6. 嵌套 if 表达式
    int n = if (a > 100) { 1 } else { if (a == 10) { 22 } else { 33 } };
    println(n);                                 // 22

    // 7. if 表达式作为函数实参
    println(Calc::triple(if (a > 5) { 3 } else { 9 }));   // 9

    // 8. if 表达式作为 return 值
    println(pick(true));                        // 7
    println(pick(false));                       // 9

    println("done");
}
