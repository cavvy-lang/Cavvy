// 测试 fn 类型后置返回类型

public fn add(int a, int b) int {
    return a + b;
}

public fn concat(String a, String b) String {
    return a + b;
}

public class Main {
    public static void main() {
        int result = add(10, 20);
        String msg = concat("Hello, ", "World");
        println("Result: " + String.valueOf(result));
        println("Message: " + msg);
    }
}
