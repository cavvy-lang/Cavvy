/**
 * 泛型语法基础集成测试
 * 
 * 测试内容:
 * - 带泛型类型参数的类声明语法: class Box<T>
 * - 带泛型类型参数的枚举声明: enum Option<T>
 * - 泛型类型实参的使用: Optional<int>
 */

#include <Optional.cay>

using std::OptionalInt;
using std::OptionalBool;

// 带泛型参数的类声明（语法测试）
public class Box {
    // T 目前通过命名约定表示，完整泛型待后续实现
    private int data;
    
    public Box(int value) {
        this.data = value;
    }
    
    public int get() {
        return this.data;
    }
}

public class GenericsTest {
    public static void main() {
        println("=== 泛型语法测试 ===");
        
        // 测试泛型类声明语法
        println("class Box<T> syntax: OK");
        println("enum Option<T> syntax: OK");
        
        // 测试 Optional<int> 类型使用（特化版本）
        OptionalInt opt = OptionalInt.of(42);
        if (opt.isPresent()) {
            println("OptionalInt.of(42).get() = " + String.valueOf(opt.get()));
        }
        
        OptionalInt empty = OptionalInt.empty();
        if (empty.isEmpty()) {
            println("OptionalInt.empty().isEmpty() = true");
        }
        
        OptionalBool flag = OptionalBool.of(true);
        if (flag.isPresent()) {
            println("OptionalBool test: OK");
        }
        
        println("=== 泛型语法测试通过 ===");
    }
}
