// let/auto 类型推断回归测试
// 修复前：let x = " String ".trim() 的初始化器无法在 codegen 推导类型，
// 会静默回退为 i32（打印出指针整数）。修复后应正确推导为 String。
fn main() {
    // 字符串字面量上的方法调用
    let x = " String ".trim();
    println(x);

    // 链式调用
    let trimmed = "  hi  ".trim().toUpperCase();
    println(trimmed);

    // String 变量上的方法调用
    string s = "hello";
    let sub = s.substring(1, 3);
    println(sub);

    // 比较表达式应推导为 bool
    let b = x.length() > 2;
    println(b);

    // 三元表达式
    let t = true ? "yes" : "no";
    println(t);

    // 字符串拼接
    let cat = "ab" + "cd";
    println(cat);

    println("done");
}
