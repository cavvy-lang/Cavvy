
public class Parent {
    protected int value;
    
    public Parent(int v) {
        this.value = v;
    }
}

public class Child extends Parent {
    public Child(int v) {
        super(v);
    }
    
    public int getValue() {
        return this.value;
    }
    
    public static void main() {
        Child c = new Child(55);
        println(String.valueOf(c.getValue()));
    }
}
