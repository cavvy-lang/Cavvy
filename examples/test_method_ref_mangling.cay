// 回归测试：静态方法引用 (ClassName::staticMethod) 作为 extern 函数指针参数
// 修复前 generate_method_ref 生成未改编名 @Class.method，
// 导致 "use of undefined value"。此处通过 libc qsort 回调验证端到端可用。
extern {
    c_void* malloc(size_t size);
    void qsort(c_void* base, size_t nmemb, size_t size, fn(c_void*, c_void*) -> c_int compar);
    void free(c_void* ptr);
}

public class IntCmp {
    /** qsort 比较回调：升序 */
    public static c_int cmp(c_void* pa, c_void* pb) {
        int a = 0;
        int b = 0;
        __ir {
            %cmp_ap = bitcast i8* %pa to i32*
            %cmp_av = load i32, i32* %cmp_ap
            store i32 %cmp_av, i32* %a
            %cmp_bp = bitcast i8* %pb to i32*
            %cmp_bv = load i32, i32* %cmp_bp
            store i32 %cmp_bv, i32* %b
        }
        return a - b;
    }
}

fn main() {
    // 写入 4 个 int: 4, 1, 3, 2
    c_void* buf = malloc(16);
    int v0 = 4;
    int v1 = 1;
    int v2 = 3;
    int v3 = 2;
    __ir {
        %w_base = load i8*, i8** %buf
        %w_p0 = bitcast i8* %w_base to i32*
        %w_v0 = load i32, i32* %v0
        store i32 %w_v0, i32* %w_p0
        %w_p1 = getelementptr i32, i32* %w_p0, i64 1
        %w_v1 = load i32, i32* %v1
        store i32 %w_v1, i32* %w_p1
        %w_p2 = getelementptr i32, i32* %w_p0, i64 2
        %w_v2 = load i32, i32* %v2
        store i32 %w_v2, i32* %w_p2
        %w_p3 = getelementptr i32, i32* %w_p0, i64 3
        %w_v3 = load i32, i32* %v3
        store i32 %w_v3, i32* %w_p3
    }

    qsort(buf, 4, 4, IntCmp::cmp);

    // 读回：应已排序为 1, 2, 3, 4
    int r0 = 0;
    int r1 = 0;
    int r2 = 0;
    int r3 = 0;
    __ir {
        %r_base = load i8*, i8** %buf
        %r_p0 = bitcast i8* %r_base to i32*
        %r_v0 = load i32, i32* %r_p0
        store i32 %r_v0, i32* %r0
        %r_p1 = getelementptr i32, i32* %r_p0, i64 1
        %r_v1 = load i32, i32* %r_p1
        store i32 %r_v1, i32* %r1
        %r_p2 = getelementptr i32, i32* %r_p0, i64 2
        %r_v2 = load i32, i32* %r_p2
        store i32 %r_v2, i32* %r2
        %r_p3 = getelementptr i32, i32* %r_p0, i64 3
        %r_v3 = load i32, i32* %r_p3
        store i32 %r_v3, i32* %r3
    }
    println(r0);
    println(r1);
    println(r2);
    println(r3);
    free(buf);
    println("done");
}
